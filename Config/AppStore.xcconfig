PRODUCT_NAME = RunningOverlay
PRODUCT_BUNDLE_IDENTIFIER = io.github.zijianwang90.runningoverlay
MARKETING_VERSION = 0.1.6
CURRENT_PROJECT_VERSION = 10
MACOSX_DEPLOYMENT_TARGET = 15.0
CODE_SIGN_ENTITLEMENTS = AppStore/RunningOverlay.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
DEVELOPMENT_TEAM =

// Native product builds use the pinned dual-backend Metal SDK. Supply SKIA_DIR
// as a build setting (or in ignored LocalSigning.xcconfig). Explicitly set
// SKIA_ENABLED=NO for SDK-free editor development; never distribute that build.
SKIA_ENABLED = YES
SKIA_EXCLUDED_NO = skia_bridge.cpp skia_gpu.mm
SKIA_HEADERS_YES = $(SKIA_DIR) $(SRCROOT)/Sources/CSkiaBridge/include
SKIA_MODULE_YES = $(SRCROOT)/Sources/CSkiaBridge/include
SKIA_LIBRARIES_YES = $(SKIA_DIR)/lib
SKIA_LINK_YES = -lskia -framework Metal -framework QuartzCore -framework CoreText -framework CoreGraphics -framework AppKit
SKIA_DEFINES_YES = SKB_ENABLE_GRAPHITE=1

// Optional ignored overrides for SDK location, team and signing settings.
#include? "LocalSigning.xcconfig"
