			border_width = number("Border Width", "BorderWidth", 1/1280, 0.0001, 0.01),
			glow = check("Active Zone Glow", "Glow", 0),
			glow_intensity = number("Zone Glow Intensity", "GlowIntensity", 0.45, 0, 1),
			ranges = {},
		}
		local defaults = {{0,134},{134,151},{152,160},{161,171},{172,178},{178,250}}
		for index, range in ipairs(defaults) do
			z.ranges[index] = {
				number("Z" .. index .. " Min HR", index .. "Min", range[1], 0, 300),
				number("Z" .. index .. " Max HR", index .. "Max", range[2], 0, 300),
			}
		end
		return z
	end
