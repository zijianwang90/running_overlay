DEFAULT_ICONS = {[0] = "Heart", "Speedometer", "Ruler", "Clock", "Mountains", "Runner", "Bolt", "Flame", "Speedometer",
	"Up-Down Arrow", "Timer", "Left-Right Arrow", "Percent", "Balance", "Thermometer", "Up-Right Arrow", "Watch", [22] = "Calendar", [24] = "Heart", [29] = "Speedometer", [30] = "Left-Right Arrow", [31] = "Left-Right Arrow", [32] = "Timer", [33] = "Clock"}

local function parse_path(path)
	local commands = {}
	for op, arguments in path:gmatch("(%a)([^%a]*)") do
		local numbers = {}
		for number in arguments:gmatch("-?[%d%.]+") do table.insert(numbers, tonumber(number)) end
		table.insert(commands, {op = op, n = numbers})
	end
	return commands
end

-- Builds a glyph path in frame units; the icon box's top-left is (left, top).
local function glyph_shape(path, left, top, size)
	local scale = size / 24
	local function point(gx, gy) return left + gx * scale, top - gy * scale end
	local shape = Shape()
	local open = false
	for _, command in ipairs(parse_path(path)) do
		local op, n = command.op, command.n
		if op == "M" then
			shape:MoveTo(point(n[1], n[2])); open = true
		elseif op == "L" then
			shape:LineTo(point(n[1], n[2]))
		elseif op == "C" then
			local x1, y1 = point(n[1], n[2])
			local x2, y2 = point(n[3], n[4])
			local x3, y3 = point(n[5], n[6])
			shape:BezierTo(x1, y1, x2, y2, x3, y3)
		elseif op == "Z" then
			shape:Close(); open = false
		elseif op == "O" or op == "A" then
			local cx, cy, r = n[1], n[2], n[3]
			local from, to = math.rad(n[4] or 0), math.rad(n[5] or 360)
			local function at(angle) return cx + r * math.cos(angle), cy + r * math.sin(angle) end
			local sx, sy = at(from)
			if open and op == "A" then shape:LineTo(point(sx, sy)) else shape:MoveTo(point(sx, sy)) end
			local steps = math.max(1, math.ceil(math.abs(to - from) / (math.pi / 2) - 1e-9))
			local step = (to - from) / steps
			local k = 4 / 3 * math.tan(step / 4) * r
			for index = 0, steps - 1 do
				local a, b = from + step * index, from + step * (index + 1)
				local ax, ay = at(a)
				local bx, by = at(b)
				local x1, y1 = point(ax - k * math.sin(a), ay + k * math.cos(a))
				local x2, y2 = point(bx + k * math.sin(b), by - k * math.cos(b))
				local x3, y3 = point(bx, by)
				shape:BezierTo(x1, y1, x2, y2, x3, y3)
			end
			if op == "O" then shape:Close(); open = false else open = true end
		end
	end
	return shape
end

-- Stroke and fill stay separate shapes so overlapping windings never cut holes.
local function icon_shapes(name, left, top, size)
	local glyph = ICON_GLYPHS[name]
	local shapes = {}
	if glyph.stroke then
		table.insert(shapes, glyph_shape(glyph.stroke, left, top, size):OutlineOfShape((glyph.weight or 2) / 24 * size,
			"OLT_Solid", "OJT_Round", 8, "SWM_Normal", 8))
	end
	if glyph.fill then table.insert(shapes, glyph_shape(glyph.fill, left, top, size)) end
	return shapes
end

-- A part is either text or a list of filled shapes; offsets move silhouettes.
local function draw_part(image, part, color, dx, dy, quality)
	if part.text ~= nil then
		draw_text(image, part.font, part.style, part.text, part.size, part.x + dx, part.y + dy, color, quality)
		return
	end
	for _, shape in ipairs(part.shapes) do
		if dx ~= 0 or dy ~= 0 then
			local matrix = Matrix4()
			matrix:Move(dx, dy, 0)
			shape = shape:TransformOfShape(matrix)
		end
		fill_shape(image, shape, color, part.sampling or quality)
	end
end

-- Fusion Gaussian blur size per shadow radius, both as fractions of frame width.
-- SwiftUI shadow radius is the Gaussian sigma; Resolve 21 Image:Blur measured
-- sigma = 0.4293 * BLUR_XSize * width on a hard edge at 1920x1080.
SHADOW_BLUR_SCALE = 1 / 0.4293

-- Mirrors the Mac layered shadow: a base layer, then tighter layers as thickness grows.
local function shadow_layers(opacity, radius, thickness)
	thickness = math.min(math.max(thickness, 1), 4)
	return {
		{opacity = opacity, radius = radius},
		{opacity = opacity * math.max(thickness - 1, 0) * 0.32, radius = radius * 0.72},
		{opacity = opacity * math.max(thickness - 2, 0) * 0.22, radius = radius * 0.48},
	}
end

local MERGE_OVER = {
	MO_ApplyMode = "Merge", MO_ApplyOperator = "Over", MO_XOffset = 0.5, MO_YOffset = 0.5,
	MO_XAxis = 0.5, MO_YAxis = 0.5, MO_XSize = 1, MO_YSize = 1, MO_Angle = 0,
	MO_FgAddSub = 1, MO_BgAddSub = 1, MO_BurnIn = 0, MO_FgRedGain = 1, MO_FgGreenGain = 1,
	MO_FgBlueGain = 1, MO_FgAlphaGain = 1, MO_Invert = 1, MO_DoZ = false,
}

-- Mac element glow: two wide shadows of the glow color. Glow radii are output
-- pixels in the Mac export; templates are authored at 1920 pixels wide.
local function glow_layers(intensity)
	intensity = math.max(intensity, 0)
	return {
		{opacity = intensity * 0.72, radius = intensity * 18 / 1920},
		{opacity = intensity * 0.35, radius = intensity * 34 / 1920},
	}
end

-- Each layer blurs an offset silhouette of every part, then merges beneath them.
local function draw_layers(image, parts, layers, color, dx, dy, quality)
	for _, layer in ipairs(layers) do
		if layer.opacity > 0 then
			local silhouette = Image({IMG_Like = image})
			silhouette:Fill(Pixel{R = 0, G = 0, B = 0, A = 0})
			for _, part in ipairs(parts) do
				draw_part(silhouette, part, Pixel{R = color.R, G = color.G, B = color.B, A = layer.opacity * part.color.A}, dx, dy, quality)
			end
			local blurred = silhouette
			if layer.radius > 0 then
				blurred = Image({IMG_Like = image})
				local size = layer.radius * SHADOW_BLUR_SCALE
				silhouette:Blur(blurred, {BLUR_Type = 4, BLUR_Red = true, BLUR_Green = true, BLUR_Blue = true, BLUR_Alpha = true,
					BLUR_XSize = size, BLUR_YSize = size, BLUR_Blend = 1, BLUR_Normalize = 1, BLUR_Passes = 0,
					BLUR_RedScale = 1, BLUR_GreenScale = 1, BLUR_BlueScale = 1, BLUR_AlphaScale = 1})
			end
			image:Merge(blurred, MERGE_OVER)
		end
	end
end

local function draw_shadow(image, parts, shadow, quality)
	draw_layers(image, parts, shadow_layers(shadow.opacity, shadow.radius, shadow.thickness), shadow, shadow.x, shadow.y, quality)
end

-- Attach to the current block bounds, so label, unit and icon never overlap.
-- Bounds use Fusion's upward Y axis. Alignment on the cross axis: 0 start
-- (top or left), 1 center, 2 end.
local function attach_box(bounds, width, height, position, spacing, alignment)
	local x, y
	if position == 0 or position == 1 then
		x = alignment == 1 and (bounds.left + bounds.right - width) / 2 or (alignment == 2 and bounds.right - width or bounds.left)
		y = position == 0 and bounds.top + spacing or bounds.bottom - spacing - height
	else
		y = alignment == 1 and (bounds.top + bounds.bottom - height) / 2 or (alignment == 2 and bounds.bottom or bounds.top - height)
		x = position == 2 and bounds.left - spacing - width or bounds.right + spacing
	end
	bounds.left = math.min(bounds.left, x)
	bounds.right = math.max(bounds.right, x + width)
	bounds.bottom = math.min(bounds.bottom, y)
	bounds.top = math.max(bounds.top, y + height)
	return x, y
end

-- Label and unit attach at the start of the cross axis.
local function attach_text(bounds, width, height, position, spacing)
	return attach_box(bounds, width, height, position, spacing, 0)
end

-- Inclusive boundaries, first matching zone wins, as in the Mac preferences.
local HR_ZONE_COLORS = {{0.12,0.56,1}, {0.28,0.82,0.96}, {0.18,0.86,0.42}, {1,0.84,0.12}, {1,0.56,0.2}, {1,0.22,0.18}}
local function heart_rate_zone(value, ranges)
	if value == nil or value ~= value then return nil end
	value = math.floor(value + 0.5)
	for index, range in ipairs(ranges) do
		if range[1] <= range[2] and value >= range[1] and value <= range[2] then
			local fraction = range[2] > range[1] and (value - range[1]) / (range[2] - range[1]) or 0.5
			return index, math.min(math.max(fraction, 0), 1)
		end
	end
	return nil
end
local function zone_frames(count, active, share)
	local result, cursor = {}, 0
	share = math.min(math.max(share, 0), 0.5)
	local expanded = active ~= nil and share > 1/count
	for index = 1, count do
		local width = expanded and (index == active and share or (1-share)/(count-1)) or 1/count
		result[index] = {start = cursor, width = width}; cursor = cursor + width
	end
	return result
end

local function distance_point_text(value, unit)
	return string.format(value >= 10 and "%.1f %s" or "%.2f %s", value, unit)
end

local function draw_diagnostic(image, font, style, title, detail, quality, color)
	local y_scale = (image.Height * image.YScale) / (image.Width * image.XScale)
	draw_text(image, font, style, title, 0.045, 0.045, 0.18 * y_scale, color, quality)
	draw_text(image, font, style, detail, 0.018, 0.045, 0.105 * y_scale, color, quality)
end

local NUDGES = {}

function Create()
	-- Sync comes first: it is the control users adjust while watching the edit.
	-- The offset is added after segment lookup, so gaps stay transparent and
	-- each cut keeps its own source mapping.
	self:AddControlPage("Sync")
	InTimeOffset = self:AddInput("Data Time Offset (s)", "TimeOffset", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_MinScale = -30,
		INP_MaxScale = 30,
		INP_Default = 0,
	})
	NUDGES = {}
	for _, definition in ipairs({
		{key = "OffsetBackSecond", label = "-1 s", delta = -1},
		{key = "OffsetBackTenth", label = "-0.1 s", delta = -0.1},
		{key = "OffsetForwardTenth", label = "+0.1 s", delta = 0.1},
		{key = "OffsetForwardSecond", label = "+1 s", delta = 1},
	}) do
		local input = self:AddInput(definition.label, definition.key, {
			LINKID_DataType = "Number",
			INPID_InputControl = "ButtonControl",
			INP_External = false,
			INP_DoNotifyChanged = true,
			INP_InitialNotify = false,
			ICD_Width = 0.25,
		})
		NUDGES[input] = definition.delta
	end
	InShowSyncReadout = self:AddInput("Show Sync Readout", "ShowSyncReadout", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Default = 0,
	})

	self:AddControlPage("Data")
	InActivityFile = self:AddInput("Activity Data (.roactivity)", "ActivityFile", {
		LINKID_DataType = "Text",
		INPID_InputControl = "FileControl",
		INP_DefaultText = "",
		INP_DoNotifyChanged = true,
	})
	InSyncFile = self:AddInput("Sync Data (.rosync)", "SyncFile", {
		LINKID_DataType = "Text",
		INPID_InputControl = "FileControl",
		INP_DefaultText = "",
		INP_DoNotifyChanged = true,
	})
	InTimelineOriginFrame = self:AddInput("Composition Start Frame (0 = Sync Start)", "TimelineOriginFrame", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_Default = 0,
		INP_Integer = true,
	})
	InAutomaticOrigin = self:AddInput("Use Sync Start Automatically", "AutomaticOrigin", {
		LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1,
	})
	InReloadData = self:AddInput("Reload Data", "ReloadData", {
		LINKID_DataType = "Number",
		INPID_InputControl = "ButtonControl",
		INP_External = false,
		INP_DoNotifyChanged = true,
		INP_InitialNotify = false,
		ICD_Width = 1.0,
	})
	InShowDiagnostics = self:AddInput("Show Diagnostics", "ShowDiagnostics", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Default = 0,
	})
	local function metric_input(label, key, default)
		return self:AddInput(label, key, {
			LINKID_DataType = "Number", INPID_InputControl = "ComboControl",
			INP_Default = default, INP_Integer = true, INP_DoNotifyChanged = true,
			{CCS_AddString = "Heart Rate"}, {CCS_AddString = "Pace"},
			{CCS_AddString = "Distance"}, {CCS_AddString = "Elapsed"},
			{CCS_AddString = "Elevation"}, {CCS_AddString = "Cadence"},
			{CCS_AddString = "Power"}, {CCS_AddString = "Calories"},
			{CCS_AddString = "Avg Pace"}, {CCS_AddString = "Vertical Oscillation"},
			{CCS_AddString = "Ground Contact Time"}, {CCS_AddString = "Stride Length"},
			{CCS_AddString = "Vertical Ratio"}, {CCS_AddString = "GCT Balance"},
			{CCS_AddString = "Temperature"}, {CCS_AddString = "Grade"},
			{CCS_AddString = "Real Time"}, {CCS_AddString = "Distance Timeline"},
		{CCS_AddString = "Route Map"}, {CCS_AddString = "HR Zone Bar"}, {CCS_AddString = "Elevation Chart"}, {CCS_AddString = "Weather"},
		{CCS_AddString = "Date"}, {CCS_AddString = "Custom Numeric"}, {CCS_AddString = "HR Zone"}, {CCS_AddString = "Running Gauge"}, {CCS_AddString = "Solid Color"},
		{CCS_AddString = "Decor Icon"}, {CCS_AddString = "Decor Text"}, {CCS_AddString = "Lap Pace"},
		{CCS_AddString = "Interval HUD Bar"}, {CCS_AddString = "Interval Timeline"},
		{CCS_AddString = "Interval Countdown"}, {CCS_AddString = "Interval Work Summary"},
		})
	end
	InMetric = metric_input("Metric", "Metric", 0)

	self:AddControlPage("Layout")
	InPosition = self:AddInput("Position", "Position", {
		LINKID_DataType = "Point",
		INPID_InputControl = "OffsetControl",
		INPID_PreviewControl = "CrosshairControl",
		INP_DefaultX = 0.08,
		INP_DefaultY = 0.84,
	})
	-- Mac numeric defaults: 28 pt value, 20 pt unit, 16 pt label, 22 pt icon and
	-- 8 pt spacing at the 1280-point reference, i.e. value / 1280 of frame width.
	InSize = self:AddInput("Value Size", "ValueSize", {
		LINKID_DataType = "Number",
		INPID_InputControl = "SliderControl",
		INP_MinScale = 0.01,
		INP_MaxScale = 0.2,
		INP_Default = 28 / 1280,
	})
	InShowLabel = self:AddInput("Show Label", "ShowLabel", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Default = 1,
	})
	InFont = self:AddInput("Font", "Font", {
		LINKID_DataType = "Text",
		INPID_InputControl = "FontFileControl",
		IC_ControlGroup = 2,
		IC_ControlID = 0,
		INP_DoNotifyChanged = true,
	})
	InFontStyle = self:AddInput("Style", "FontStyle", {
		LINKID_DataType = "Text",
		INPID_InputControl = "FontFileControl",
		IC_ControlGroup = 2,
		IC_ControlID = 1,
		INP_DoNotifyChanged = true,
	})
	InR = self:AddInput("Red", "Red", {
		LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
		INP_MinScale = 0, INP_MaxScale = 1, INP_Default = 1,
		ICS_Name = "Color", CLRC_ShowWheel = false, IC_ControlGroup = 1, IC_ControlID = 0,
	})
	InG = self:AddInput("Green", "Green", {
		LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
		INP_MinScale = 0, INP_MaxScale = 1, INP_Default = 1,
		IC_ControlGroup = 1, IC_ControlID = 1,
	})
	InB = self:AddInput("Blue", "Blue", {
		LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
		INP_MinScale = 0, INP_MaxScale = 1, INP_Default = 1,
		IC_ControlGroup = 1, IC_ControlID = 2,
	})
	InA = self:AddInput("Alpha", "Alpha", {
		LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
		INP_MinScale = 0, INP_MaxScale = 1, INP_Default = 1,
		IC_ControlGroup = 1, IC_ControlID = 3,
	})
	InHeartRateEnabled = self:AddInput("Show Heart Rate", "HeartRateEnabled", {
		LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 1,
	})
	-- Inputs that only apply to number widgets or only to the distance timeline;
	-- NotifyChanged shows one group per slot according to its metric.
	local function add(group, label, key, attributes)
		local input = self:AddInput(label, key, attributes)
		if group ~= nil then table.insert(group, input) end
		return input
	end
	local function number_in(group, label, key, default, min, max)
		return add(group, label, key, {LINKID_DataType = "Number", INPID_InputControl = "SliderControl",
			INP_Default = default, INP_MinScale = min, INP_MaxScale = max})
	end
	local function combo_in(group, label, key, choices, default)
		local attributes = {LINKID_DataType = "Number", INPID_InputControl = "ComboControl", INP_Default = default or 0, INP_Integer = true}
		for _, choice in ipairs(choices) do table.insert(attributes, {CCS_AddString = choice}) end
		return add(group, label, key, attributes)
	end
	local function check_in(group, label, key, default)
		return add(group, label, key, {LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = default})
	end
	local function color_in(group, name, key, defaults, control_group, with_alpha)
		local inputs = {}
		for component, suffix in ipairs(with_alpha and {"R", "G", "B", "A"} or {"R", "G", "B"}) do
			inputs[component] = add(group, name .. " " .. suffix, key .. suffix, {
				LINKID_DataType = "Number", INPID_InputControl = "ColorControl", INP_Default = defaults[component],
				INP_MinScale = 0, INP_MaxScale = 1, ICS_Name = name, IC_ControlGroup = control_group, IC_ControlID = component - 1})
		end
		return inputs
	end
	local function text_options(key, numeric)
		local function number(label, suffix, default, max) return number_in(numeric, label, key .. suffix, default, 0, max) end
		local function combo(label, suffix, choices, default) return combo_in(numeric, label, key .. suffix, choices, default) end
		local result = {}
		result.units = {
			[1] = combo("Pace Units", "PaceUnits", {"min/km", "min/mi", "min/500m"}),
			[2] = combo("Distance Units", "DistanceUnits", {"km", "mi", "m"}),
			[3] = combo("Elapsed Format", "DurationFormat", {"hh:mm:ss", "mm:ss", "seconds"}),
			[4] = combo("Elevation Units", "ElevationUnits", {"m", "ft"}),
			[9] = combo("Oscillation Units", "OscillationUnits", {"cm", "mm"}),
			[14] = combo("Temperature Units", "TemperatureUnits", {"Celsius", "Fahrenheit"}),
			[16] = combo("Clock Format", "ClockFormat", {"24-hour", "12-hour"}),
			[22] = combo("Date Format", "DateFormat", {"yyyy-MM-dd", "yyyy/MM/dd", "MM/dd/yyyy", "MM-dd", "MM/dd", "MMM d"}),
		}
		result.units[8] = result.units[1]
		result.units[29] = result.units[1]
		result.temperature_source = combo("Temperature Source", "TemperatureSource", {"FIT", "FIT, else manual", "Manual"})
		result.manual_temperature = number_in(numeric, "Manual Temperature (°C)", key .. "ManualTemperature", 20, -30, 45)
		result.clock_offset = number_in(numeric, "Clock UTC Offset (h)", key .. "ClockUtcOffset", 0, -12, 14)
		result.custom_field = combo("Custom Source", "CustomField", {"Timestamp", "Elapsed Time", "Distance (m)", "Heart Rate",
			"Pace (s/km)", "Avg Pace (s/km)", "Elevation (m)", "Cadence", "Power (W)", "Calories", "Latitude", "Longitude",
			"Vert. Osc. (mm)", "GCT (ms)", "Stride (m)", "Vert. Ratio (%)", "GCT Balance (%)", "Temperature (°C)", "Grade (%)"}, 10)
		result.custom_format = combo("Custom Format", "CustomFormat", {"Number", "Integer", "Duration", "Clock Time", "Date",
			"Pace", "Percent", "Coordinate"}, 7)
		result.custom_precision = number_in(numeric, "Custom Precision", key .. "CustomPrecision", 5, 0, 4)
		result.custom_unit = add(numeric, "Custom Unit (blank = automatic)", key .. "CustomUnit", {
			LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", INP_DefaultText = "", TEC_Lines = 1})
		result.custom_label = add(numeric, "Custom Label (blank = default)", key .. "CustomLabel", {
			LINKID_DataType = "Text", INPID_InputControl = "TextEditControl", INP_DefaultText = "", TEC_Lines = 1})
		result.show_unit = check_in(numeric, "Show Unit", key .. "ShowUnit", 1)
		for index, part in ipairs({"Label", "Unit"}) do
			local controls = {}
			controls.position = combo(part .. " Position", part .. "Position", {"Top", "Bottom", "Left", "Right"}, part == "Unit" and 3 or 0)
			controls.alignment = combo(part .. " Alignment", part .. "Alignment", {"Start", "Center", "End"}, part == "Unit" and 2 or 0)
			controls.spacing = number(part .. " Spacing", part .. "Spacing", 0.008, 0.1)
			controls.size = number(part .. " Size", part .. "Size", (part == "Unit" and 20 or 16) / 1280, 0.2)
			controls.font = add(numeric, part .. " Font", key .. part .. "Font", {
				LINKID_DataType = "Text", INPID_InputControl = "FontFileControl", IC_ControlGroup = index + 2, IC_ControlID = 0})
			controls.style = add(numeric, part .. " Style", key .. part .. "FontStyle", {
				LINKID_DataType = "Text", INPID_InputControl = "FontFileControl", IC_ControlGroup = index + 2, IC_ControlID = 1})
			controls.color = color_in(numeric, part .. " Color", key .. part, {1, 1, 1, 1}, index + 10, true)
			result[part] = controls
		end
		-- Mac numeric icon defaults: leading, centered, 22 pt with 8 pt spacing, white.
		local icon = {}
		icon.enabled = check_in(numeric, "Show Icon", key .. "IconEnabled", 1)
		icon.glyph = combo("Icon", "IconGlyph", ICON_NAMES, 0)
		icon.position = combo("Icon Position", "IconPosition", {"Top", "Bottom", "Left", "Right"}, 2)
		icon.alignment = combo("Icon Alignment", "IconAlignment", {"Start", "Center", "End"}, 1)
		icon.size = number("Icon Size", "IconSize", 22 / 1280, 0.1)
		icon.spacing = number("Icon Spacing", "IconSpacing", 8 / 1280, 0.05)
		icon.color = color_in(numeric, "Icon Color", key .. "Icon", {1, 1, 1, 1}, 14, true)
		result.icon = icon
		-- Mac defaults: black, 35%, radius 4 and 2 down. Radius and offset are
		-- output pixels in the Mac export, authored at 1920 pixels wide.
		local shadow = {}
		shadow.enabled = check_in(nil, "Shadow", key .. "ShadowEnabled", 1)
		shadow.color = color_in(nil, "Shadow Color", key .. "Shadow", {0, 0, 0}, 13, false)
		shadow.opacity = number_in(nil, "Shadow Opacity", key .. "ShadowOpacity", 0.35, 0, 1)
		shadow.radius = number_in(nil, "Shadow Blur", key .. "ShadowBlur", 4 / 1920, 0, 0.02)
		shadow.x = number_in(nil, "Shadow Offset X", key .. "ShadowOffsetX", 0, -0.02, 0.02)
		shadow.y = number_in(nil, "Shadow Offset Y", key .. "ShadowOffsetY", -2 / 1920, -0.02, 0.02)
		shadow.thickness = number_in(nil, "Shadow Thickness", key .. "ShadowThickness", 1, 1, 4)
		result.shadow = shadow
		return result
	end
	-- Defaults reproduce the Easy Run and Race template timeline at the
	-- 1280-point reference; colors are the template's green accent.
	local function timeline_options(key, group)
		local function number(label, suffix, default, min, max) return number_in(group, label, key .. "Timeline" .. suffix, default, min, max) end
		local function combo(label, suffix, choices, default) return combo_in(group, label, key .. "Timeline" .. suffix, choices, default) end
		local function check(label, suffix, default) return check_in(group, label, key .. "Timeline" .. suffix, default) end
		local accent = {0.25, 0.82, 0.38}
		local t = {}
		t.width = number("Timeline Width", "Width", 522.08 / 1280, 0.05, 1)
		t.height = number("Timeline Height", "Height", 68 / 1280, 0.01, 0.3)
		t.padding_x = number("Padding X", "PaddingX", 14 / 1280, 0, 0.05)
		t.padding_y = number("Padding Y", "PaddingY", 10 / 1280, 0, 0.05)
		t.show_value = check("Show Distance", "ShowValue", 1)
		t.show_total = check("Show Total Distance", "ShowTotal", 1)
		t.units = combo("Distance Units", "Units", {"km", "mi"}, 0)
		t.value_size = number("Distance Size", "ValueSize", 19 / 1280, 0.005, 0.1)
		t.value_spacing = number("Distance Spacing", "ValueSpacing", 8 / 1280, 0, 0.05)
		t.track_height = number("Track Height", "TrackHeight", 6 / 1280, 0.001, 0.05)
		t.track_opacity = number("Track Opacity", "TrackOpacity", 0.62945, 0, 1)
		t.fill = color_in(group, "Fill Color", key .. "TimelineFill", accent, 15, false)
		t.glow = check("Progress Glow", "Glow", 1)
		t.ticks = check("Tick Marks", "Ticks", 1)
		t.tick_density = number("Tick Density", "TickDensity", 12, 2, 64)
		t.marker = check("Current Marker", "Marker", 1)
		t.marker_style = combo("Marker Style", "MarkerStyle", {"Dot", "Pill", "Triangle"}, 0)
		t.marker_size = number("Marker Size", "MarkerSize", 1, 0.25, 4)
		t.marker_color = color_in(group, "Marker Color", key .. "TimelineMarker", accent, 16, false)
		t.axis_labels = check("Axis Labels", "AxisLabels", 1)
		t.axis_mode = combo("Axis Label Mode", "AxisMode", {"Start / Finish", "Distance"}, 0)
		t.endpoint_placement = combo("Endpoint Labels", "EndpointPlacement", {"Below", "Above"}, 0)
		t.endpoint_offset = number("Endpoint Label Gap", "EndpointOffset", 14.123 / 1280, 0, 0.1)
		t.points = check("Distance Points", "Points", 1)
		t.point_count = number("Distance Point Count", "PointCount", 3, 0, 12)
		t.midpoint_placement = combo("Distance Point Labels", "MidpointPlacement", {"Below", "Above"}, 0)
		t.midpoint_offset = number("Distance Point Gap", "MidpointOffset", 14.123 / 1280, 0, 0.1)
		t.axis_font = add(group, "Axis Font", key .. "TimelineAxisFont", {
			LINKID_DataType = "Text", INPID_InputControl = "FontFileControl", IC_ControlGroup = 5, IC_ControlID = 0})
		t.axis_style = add(group, "Axis Style", key .. "TimelineAxisFontStyle", {
			LINKID_DataType = "Text", INPID_InputControl = "FontFileControl", IC_ControlGroup = 5, IC_ControlID = 1})
		t.axis_size = number("Axis Label Size", "AxisSize", 10 / 1280, 0.003, 0.05)
		t.axis_color = color_in(group, "Axis Color", key .. "TimelineAxis", {1, 1, 1, 1}, 17, true)
		t.element_glow = check("Element Glow", "ElementGlow", 1)
		t.glow_intensity = number("Glow Intensity", "GlowIntensity", 0.1, 0, 1)
		t.glow_color = color_in(group, "Glow Color", key .. "TimelineGlow", accent, 18, false)
		return t
	end
