	VisibilityGroups = {}
	local primary_numeric, primary_timeline, primary_route, primary_zone, primary_elevation, primary_weather, primary_gauge, primary_decor = {InSize, InShowLabel}, {}, {}, {}, {}, {}, {}, {}
	local primary_hud, primary_interval_timeline, primary_countdown, primary_summary = {}, {}, {}, {}
	PrimaryTextOptions = text_options("", primary_numeric)
	PrimaryTimelineOptions = timeline_options("", primary_timeline)
	PrimaryRouteOptions = route_options("", primary_route)
	PrimaryZoneOptions = zone_options("", primary_zone)
	PrimaryElevationOptions = elevation_options("", primary_elevation)
	PrimaryWeatherOptions = weather_options("", primary_weather)
	PrimaryGaugeOptions = gauge_options("", primary_gauge)
	PrimaryDecorOptions = decor_options("", primary_decor)
	PrimaryHudOptions = interval_hud_options("", primary_hud)
	PrimaryIntervalTimelineOptions = interval_timeline_options("", primary_interval_timeline)
	PrimaryCountdownOptions = interval_countdown_options("", primary_countdown)
	PrimarySummaryOptions = interval_summary_options("", primary_summary)
	VisibilityGroups[InMetric] = {numeric = primary_numeric, timeline = primary_timeline, route = primary_route, zone = primary_zone, elevation = primary_elevation, weather = primary_weather, gauge = primary_gauge, decor = primary_decor,
		hud = primary_hud, intervalTimeline = primary_interval_timeline, countdown = primary_countdown, summary = primary_summary}
	WidgetInputs = {}
	local definitions = {
		{key = "Pace", label = "Pace", metric = 1},
		{key = "Distance", label = "Distance", metric = 2},
		{key = "Elapsed", label = "Elapsed", metric = 3},
	}
	for slot = 5, 16 do
		table.insert(definitions, {key = "Widget" .. slot, label = "Widget " .. slot, metric = 0})
	end
	for slot, definition in ipairs(definitions) do
		local key = definition.key
		local numeric, timeline, route, zone, elevation, weather, gauge, decor = {}, {}, {}, {}, {}, {}, {}, {}
		local hud, interval_timeline_group, countdown, summary = {}, {}, {}, {}
		self:AddControlPage(definition.label)
		local controls = {}
		controls.metric = metric_input("Metric", key .. "Metric", definition.metric)
		controls.enabled = self:AddInput("Show " .. definition.label, key .. "Enabled", {
			LINKID_DataType = "Number", INPID_InputControl = "CheckboxControl", INP_Default = 0,
		})
		controls.position = self:AddInput("Position", key .. "Position", {
			LINKID_DataType = "Point", INPID_InputControl = "OffsetControl",
			INPID_PreviewControl = "CrosshairControl", INP_DefaultX = 0.08, INP_DefaultY = 0.68,
		})
		controls.size = number_in(numeric, "Value Size", key .. "ValueSize", 28 / 1280, 0.01, 0.2)
		controls.label = check_in(numeric, "Show Label", key .. "ShowLabel", 1)
		controls.font = self:AddInput("Font", key .. "Font", {
			LINKID_DataType = "Text", INPID_InputControl = "FontFileControl",
			IC_ControlGroup = 2, IC_ControlID = 0, INP_DoNotifyChanged = true,
		})
		controls.font_style = self:AddInput("Style", key .. "FontStyle", {
			LINKID_DataType = "Text", INPID_InputControl = "FontFileControl",
			IC_ControlGroup = 2, IC_ControlID = 1, INP_DoNotifyChanged = true,
		})
		controls.color = {}
		for index, component in ipairs({"R", "G", "B", "A"}) do
			controls.color[index] = self:AddInput(component, key .. component, {
				LINKID_DataType = "Number", INPID_InputControl = "ColorControl",
				INP_MinScale = 0, INP_MaxScale = 1, INP_Default = 1,
				ICS_Name = "Color", CLRC_ShowWheel = false,
				IC_ControlGroup = 1, IC_ControlID = index - 1,
			})
		end
		controls.text = text_options(key, numeric)
		controls.timeline = timeline_options(key, timeline)
		controls.route = route_options(key, route)
		controls.zone = zone_options(key, zone)
		controls.elevation = elevation_options(key, elevation)
		controls.weather = weather_options(key, weather)
		controls.gauge = gauge_options(key, gauge)
		controls.decor = decor_options(key, decor)
		controls.hud = interval_hud_options(key, hud)
		controls.interval_timeline = interval_timeline_options(key, interval_timeline_group)
		controls.countdown = interval_countdown_options(key, countdown)
		controls.summary = interval_summary_options(key, summary)
		VisibilityGroups[controls.metric] = {numeric = numeric, timeline = timeline, route = route, zone = zone, elevation = elevation, weather = weather, gauge = gauge, decor = decor,
			hud = hud, intervalTimeline = interval_timeline_group, countdown = countdown, summary = summary}
		WidgetInputs[slot] = controls
	end
	-- No default metric is a timeline; NotifyChanged reveals them per slot.
	for _, groups in pairs(VisibilityGroups) do
		for _, input in ipairs(groups.timeline) do input:SetAttrs({IC_Visible = false}) end
		for _, input in ipairs(groups.route) do input:SetAttrs({IC_Visible = false}) end
		for _, input in ipairs(groups.zone) do input:SetAttrs({IC_Visible = false}) end
		for _, input in ipairs(groups.elevation) do input:SetAttrs({IC_Visible = false}) end
		for _, input in ipairs(groups.weather) do input:SetAttrs({IC_Visible = false}) end
		for _, input in ipairs(groups.gauge) do input:SetAttrs({IC_Visible = false}) end
		for _, input in ipairs(groups.decor) do input:SetAttrs({IC_Visible = false}) end
		for _, input in ipairs(groups.hud) do input:SetAttrs({IC_Visible = false}) end
		for _, input in ipairs(groups.intervalTimeline) do input:SetAttrs({IC_Visible = false}) end
		for _, input in ipairs(groups.countdown) do input:SetAttrs({IC_Visible = false}) end
		for _, input in ipairs(groups.summary) do input:SetAttrs({IC_Visible = false}) end
	end
end

function NotifyChanged(input, parameter, time)
	if input == InFont then
		local value = parameter and tostring(parameter.Value) or ""
		if value == "" then InFont:SetSource(Text("Open Sans"), time) end
	elseif input == InFontStyle then
		local value = parameter and tostring(parameter.Value) or ""
		if value == "" then InFontStyle:SetSource(Text("Regular"), time) end
	elseif input == InReloadData then
		DataCache = {}
	elseif VisibilityGroups ~= nil and VisibilityGroups[input] ~= nil then
		local metric = parameter ~= nil and math.floor((parameter.Value or 0) + 0.5) or 0
		local kind = ({[TIMELINE_METRIC] = "timeline", [ROUTE_METRIC] = "route", [ZONE_METRIC] = "zone", [ELEVATION_METRIC] = "elevation", [WEATHER_METRIC] = "weather", [HR_ZONE_METRIC] = "zone", [GAUGE_METRIC] = "gauge", [DECOR_SOLID_METRIC] = "decor", [DECOR_ICON_METRIC] = "decor", [DECOR_TEXT_METRIC] = "decor", [INTERVAL_HUD_METRIC] = "hud", [INTERVAL_TIMELINE_METRIC] = "intervalTimeline", [INTERVAL_COUNTDOWN_METRIC] = "countdown", [INTERVAL_SUMMARY_METRIC] = "summary"})[metric] or "numeric"
		for name, controls in pairs(VisibilityGroups[input]) do
			for _, control in ipairs(controls) do control:SetAttrs({IC_Visible = name == kind}) end
		end
	elseif NUDGES[input] ~= nil then
		local current = InTimeOffset:GetSource(time).Value or 0
		local nudged = math.floor((current + NUDGES[input]) * 1000 + 0.5) / 1000
		InTimeOffset:SetSource(Number(nudged), time)
	else
		for _, controls in pairs(WidgetInputs) do
			if input == controls.font and (not parameter or tostring(parameter.Value or "") == "") then
				controls.font:SetSource(Text("Open Sans"), time)
			elseif input == controls.font_style and (not parameter or tostring(parameter.Value or "") == "") then
				controls.font_style:SetSource(Text("Regular"), time)
			end
		end
	end
end

function Process(req)
	local activity_path = tostring(InActivityFile:GetValue(req).Value or "")
	local sync_path = tostring(InSyncFile:GetValue(req).Value or "")
	local data = load_data(activity_path, sync_path)

	local real_width = Width
	local real_height = Height
	-- Process can run for several Fuse instances on Fusion worker threads. Never
	-- rewrite the host's shared size/proxy globals while another node renders.
	local render_width = Width / Scale
	local render_height = Height / Scale
	local attributes = {
		IMG_Document = self.Comp,
		IMG_Width = render_width,
		IMG_Height = render_height,
		IMG_XScale = XAspect,
		IMG_YScale = YAspect,
		IMAT_OriginalWidth = real_width,
		IMAT_OriginalHeight = real_height,
		IMG_Quality = not req:IsQuick(),
	}
	if not req:IsStampOnly() then attributes.IMG_ProxyScale = 1 end
	if SourceDepth ~= 0 then attributes.IMG_Depth = SourceDepth end
	local output = Image(attributes)
	if output == nil then OutImage:Set(req, nil) return end
	output:Fill(Pixel{R = 0, G = 0, B = 0, A = 0})

	ensure_fonts()
	local font = InFont:GetValue(req).Value
	local style = InFontStyle:GetValue(req).Value
	if font == nil or tostring(font) == "" then font = "Open Sans" end
	if style == nil or tostring(style) == "" then style = "Regular" end
	local quality = req:IsQuick() and 1 or 32
	local diagnostics_enabled = InShowDiagnostics:GetValue(req).Value > 0.5
	if data.error ~= nil then
		draw_diagnostic(
			output, font, style, "RUNNING OVERLAY DATA ERROR", tostring(data.error), quality,
			Pixel{R = 1, G = 0.2, B = 0.15, A = 1}
		)
		OutImage:Set(req, output)
		return
	end

	local configured_origin = math.floor(InTimelineOriginFrame:GetValue(req).Value + 0.5)
	local origin = (InAutomaticOrigin:GetValue(req).Value > 0.5 and configured_origin == 0) and data.timeline_start_frame or configured_origin
	local timeline_frame = math.floor(req.Time + origin + 0.5)
	local offset_seconds = InTimeOffset:GetValue(req).Value or 0
	local elapsed_us = activity_elapsed_at_frame(data, timeline_frame)
	if elapsed_us ~= nil then elapsed_us = elapsed_us + math.floor(offset_seconds * 1000000 + 0.5) end
	local sample = elapsed_us and sample_activity(data, elapsed_us) or nil
	if InShowSyncReadout:GetValue(req).Value > 0.5 then
		local readout = elapsed_us == nil
			and string.format("No sync segment at Resolve frame %d", timeline_frame)
			or string.format("Activity %s.%d  ·  offset %+.3f s", format_duration(math.floor(elapsed_us / 1000000)),
				math.floor(elapsed_us / 100000) % 10, offset_seconds)
		local y_scale = (output.Height * output.YScale) / (output.Width * output.XScale)
		draw_text(output, font, style, readout, 0.02, 0.045, 0.045 * y_scale, Pixel{R = 1, G = 0.85, B = 0.3, A = 1}, quality)
	end
	local has_decor = false
	local function is_decor(metric)
		return metric == DECOR_SOLID_METRIC or metric == DECOR_ICON_METRIC or metric == DECOR_TEXT_METRIC
	end
	if InHeartRateEnabled:GetValue(req).Value > 0.5 and is_decor(math.floor(InMetric:GetValue(req).Value + 0.5)) then has_decor = true end
	for _, controls in ipairs(WidgetInputs) do
		if controls.enabled:GetValue(req).Value > 0.5 and is_decor(math.floor(controls.metric:GetValue(req).Value + 0.5)) then has_decor = true end
	end
	if sample ~= nil or has_decor then
		local aspect = (output.Height * output.YScale) / (output.Width * output.XScale)
		local function value_of(input) return input:GetValue(req).Value end
		local function color_of(inputs, alpha)
			return Pixel{R = value_of(inputs[1]), G = value_of(inputs[2]), B = value_of(inputs[3]), A = alpha or (inputs[4] and value_of(inputs[4]) or 1)}
		end
		local function font_of(font_input, style_input)
			local part_font = tostring(value_of(font_input) or "")
			local part_style = tostring(value_of(style_input) or "")
			return part_font == "" and "Open Sans" or part_font, part_style == "" and "Regular" or part_style
		end
		local function shadow_of(options)
			local shadow = options.shadow
			if value_of(shadow.enabled) <= 0.5 then return nil end
			return {R = value_of(shadow.color[1]), G = value_of(shadow.color[2]), B = value_of(shadow.color[3]),
				opacity = value_of(shadow.opacity), radius = value_of(shadow.radius),
				x = value_of(shadow.x), y = value_of(shadow.y), thickness = value_of(shadow.thickness)}
		end
		local function render_widget(metric, position, size, show_label, widget_font, widget_style, color, options, zone_options)
			local unit_input = options.units[metric]
			local source = math.floor(options.temperature_source:GetValue(req).Value + 0.5)
			local manual = source > 0 and options.manual_temperature:GetValue(req).Value or nil
			local zone_label = nil
			if metric == HR_ZONE_METRIC and zone_options ~= nil then
				local z = zone_options
				local count = math.floor(value_of(z.count) + 0.5) == 0 and 5 or 6
				local ranges = {}
				for index = 1, count do
					ranges[index] = {math.floor(value_of(z.ranges[index][1]) + 0.5),
						math.floor(value_of(z.ranges[index][2]) + 0.5)}
				end
				local zone_index = heart_rate_zone(sample.heart_rate, ranges)
				if zone_index ~= nil then zone_label = "Z" .. zone_index end
			end
			local label, value, unit = metric_text(metric, sample, elapsed_us, data, unit_input and unit_input:GetValue(req).Value or 0,
				manual, source < 2, options.clock_offset:GetValue(req).Value,
				options.custom_field:GetValue(req).Value, options.custom_format:GetValue(req).Value,
				options.custom_precision:GetValue(req).Value, options.custom_unit:GetValue(req).Value, zone_label)
			local custom = tostring(options.custom_label:GetValue(req).Value or ""):match("^%s*(.-)%s*$")
			if custom ~= "" then label = custom end
			-- Mac anchors a numeric element's top-left corner at Position, in both
			-- the preview alignment guide and the export rect, while Fusion draws
			-- text from its baseline. The minimal preset's 10x6 design-point
			-- padding moves the value in by 10/1280 and 6/1280 of frame width.
			local ascent, descent = font_extents(widget_font, widget_style, size)
			local x = position.X + 10 / 1280
			local y = position.Y * aspect - 6 / 1280 - ascent
			-- Lay out every part first so the shadow pass can sit beneath all of them.
			local value_width = text_width(widget_font, widget_style, value, size)
			local parts = {{font = widget_font, style = widget_style, text = value, size = size, x = x, y = y, color = color}}
			local bounds = {left = x, right = x + value_width, bottom = y - descent, top = y + ascent}
			local function attachment(text, controls)
				if text == "" then return end
				local part_font, part_style = font_of(controls.font, controls.style)
				local part_size = controls.size:GetValue(req).Value
				local width = text_width(part_font, part_style, text, part_size)
				local part_ascent, part_descent = font_extents(part_font, part_style, part_size)
				local px, bottom = attach_box(bounds, width, part_ascent + part_descent,
					value_of(controls.position), value_of(controls.spacing), value_of(controls.alignment))
				table.insert(parts, {font = part_font, style = part_style, text = text, size = part_size, x = px, y = bottom + part_descent,
					color = color_of(controls.color)})
			end
			if options.show_unit:GetValue(req).Value > 0.5 then attachment(unit, options.Unit) end
			if show_label then attachment(label, options.Label) end
			-- The icon wraps the whole text block, as in the Mac layout. Its cross-axis
			-- alignment uses the value's line box, which SwiftUI aligns against.
			local icon = options.icon
			local glyph = math.floor(value_of(icon.glyph) + 0.5)
			local icon_name = glyph > 0 and ICON_NAMES[glyph + 1] or DEFAULT_ICONS[metric]
			if value_of(icon.enabled) > 0.5 and ICON_GLYPHS[icon_name] ~= nil then
				local icon_size = value_of(icon.size)
				local ascent, descent = font_extents(widget_font, widget_style, size)
				local block = {left = bounds.left, right = bounds.right,
					top = math.max(bounds.top, y + ascent), bottom = math.min(bounds.bottom, y - descent)}
				local ix, iy = attach_box(block, icon_size, icon_size, math.floor(value_of(icon.position) + 0.5),
					value_of(icon.spacing), math.floor(value_of(icon.alignment) + 0.5))
				table.insert(parts, {shapes = icon_shapes(icon_name, ix, iy + icon_size, icon_size), color = color_of(icon.color)})
			end
			local shadow = shadow_of(options)
			if shadow ~= nil then draw_shadow(output, parts, shadow, quality) end
			for _, part in ipairs(parts) do draw_part(output, part, part.color, 0, 0, quality) end
		end
		-- Mac DistanceTimelineOverlayView, minimal preset: the box is centered on
		-- Position; the distance value sits above a capsule track with ticks, a
		-- progress fill and marker, and axis labels below or above the track.
		local function render_timeline(position, value_font, value_style, color, t, options)
			local pixel = 1 / output.Width
			local width, height = value_of(t.width), value_of(t.height)
			local padding_x, padding_y = value_of(t.padding_x), value_of(t.padding_y)
			local left, top = position.X - width / 2, position.Y * aspect + height / 2
			local content_left, content_top = left + padding_x, top - padding_y
			local content_width, content_height = math.max(width - padding_x * 2, pixel), math.max(height - padding_y * 2, pixel)
			local track_height = math.max(value_of(t.track_height), 2 / 1280)
			local value_size = math.max(value_of(t.value_size), 12 / 1280)
			local axis_size = math.max(value_of(t.axis_size), 8 / 1280)
			local show_value = value_of(t.show_value) > 0.5
			local value_block = show_value and value_size * 1.35 or 0
			local track_top = content_top - math.min(content_height - track_height, value_block + value_of(t.value_spacing))
			local track_bottom = track_top - track_height
			local track_middle = track_bottom + track_height / 2

			-- Progress follows distance. Without any distance data it follows time,
			-- like the Mac app; a sample without distance leaves the fill empty.
			local imperial = math.floor(value_of(t.units) + 0.5) == 1
			local divisor, unit = imperial and 1609.344 or 1000, imperial and "mi" or "km"
			local total = data.total_distance_m or 0
			local current = sample.distance_m
			local progress = nil
			if total > 0 then
				if current ~= nil then progress = current / total end
			else
				progress = elapsed_us / math.max(data.duration_us or 0, 1000000)
			end
			if progress ~= nil then progress = math.min(math.max(progress, 0), 1) end

			local accent = color_of(t.fill, 1)
			local parts, overlays = {}, {}
			table.insert(parts, {shapes = {capsule(content_left, track_bottom, content_width, track_height)},
				color = Pixel{R = color.R, G = color.G, B = color.B, A = color.A * value_of(t.track_opacity)}})
			local glow = value_of(t.glow) > 0.5
			if progress ~= nil then
				local fill = {shapes = {capsule(content_left, track_bottom, math.max(content_width * progress, track_height), track_height)}, color = accent}
				table.insert(parts, fill)
				overlays[fill] = glow and track_height * 2.8 or nil
			end
			if value_of(t.ticks) > 0.5 then
				local count = math.max(math.floor(value_of(t.tick_density) + 0.5), 2)
				local ticks = Shape()
				for index = 0, count do
					local x = content_left + content_width * index / count
					ticks:AddRectangle(x - pixel / 2, x + pixel / 2, track_top + track_height * 0.45, track_bottom - track_height * 0.45, 0, 8)
				end
				table.insert(parts, {shapes = {ticks}, color = Pixel{R = color.R, G = color.G, B = color.B, A = color.A * 0.64 * 0.52}})
			end
			if progress ~= nil and value_of(t.marker) > 0.5 then
				local x = content_left + content_width * progress
				local multiplier = value_of(t.marker_size)
				local style = math.floor(value_of(t.marker_style) + 0.5)
				local shape
				if style == 2 then
					local half, marker_height = track_height * 1.3 * multiplier, track_height * 2.4 * multiplier
					shape = Shape()
					shape:MoveTo(x, track_middle + marker_height / 2)
					shape:LineTo(x + half, track_middle - marker_height / 2)
					shape:LineTo(x - half, track_middle - marker_height / 2)
					shape:Close()
				else
					local marker_width = track_height * (style == 1 and 3.4 or 2.2) * multiplier
					local marker_height = track_height * (style == 1 and 1.75 or 2.2) * multiplier
					shape = capsule(x - marker_width / 2, track_middle - marker_height / 2, marker_width, marker_height)
				end
				local marker = {shapes = {shape}, color = color_of(t.marker_color, 1)}
				table.insert(parts, marker)
				overlays[marker] = glow and track_height * 2.3 or nil
			end

			if show_value then
				local current_text = current ~= nil and string.format("%.2f", current / divisor) or "--"
				local text = value_of(t.show_total) > 0.5 and string.format("%s / %.2f %s", current_text, total / divisor, unit)
					or current_text .. " " .. unit
				local ascent = font_extents(value_font, value_style, value_size)
				table.insert(parts, {font = value_font, style = value_style, text = text, size = value_size,
					x = content_left, y = content_top - ascent, color = color})
			end
			local axis_font, axis_style = font_of(t.axis_font, t.axis_style)
			local axis_color = color_of(t.axis_color)
			local axis_ascent, axis_descent = font_extents(axis_font, axis_style, axis_size)
			-- Mac centers each label's line box in a band of 1.3 x size at the gap.
			local function axis_baseline(placement_input, gap_input)
				local band = axis_size * 1.3
				local gap = value_of(gap_input)
				local center = math.floor(value_of(placement_input) + 0.5) == 1 and track_top + gap + band / 2 or track_bottom - gap - band / 2
				return center + (axis_descent - axis_ascent) / 2
			end
			local function axis_text(text, x, baseline, anchor)
				local text_w = text_width(axis_font, axis_style, text, axis_size)
				table.insert(parts, {font = axis_font, style = axis_style, text = text, size = axis_size,
					x = x - text_w * anchor, y = baseline, color = axis_color})
			end
			if value_of(t.axis_labels) > 0.5 then
				local baseline = axis_baseline(t.endpoint_placement, t.endpoint_offset)
				local by_distance = math.floor(value_of(t.axis_mode) + 0.5) == 1
				axis_text(by_distance and "0 " .. unit or "START", content_left, baseline, 0)
				axis_text(by_distance and string.format("%.2f %s", total / divisor, unit) or "FINISH", content_left + content_width, baseline, 1)
			end
			local count = math.floor(value_of(t.point_count) + 0.5)
			if value_of(t.points) > 0.5 and count > 0 then
				local baseline = axis_baseline(t.midpoint_placement, t.midpoint_offset)
				for index = 1, count do
					axis_text(distance_point_text(total / divisor * index / (count + 1), unit),
						content_left + content_width * index / (count + 1), baseline, 0.5)
				end
			end

			-- Element glow, then the element shadow, both of the whole widget; the
			-- fill and marker carry their own accent glow beneath them.
			if value_of(t.element_glow) > 0.5 then
				draw_layers(output, parts, glow_layers(value_of(t.glow_intensity)), color_of(t.glow_color, 1), 0, 0, quality)
			end
			local shadow = shadow_of(options)
			if shadow ~= nil then draw_shadow(output, parts, shadow, quality) end
			for _, part in ipairs(parts) do
				if overlays[part] ~= nil then
					draw_layers(output, {part}, {{opacity = 0.75, radius = overlays[part]}}, part.color, 0, 0, quality)
				end
				draw_part(output, part, part.color, 0, 0, quality)
			end
		end
		local function render_route(position, widget_font, widget_style, r, options)
			local route = data.route or {paths = {}, count = 0}
			local size = math.max(value_of(r.size), 2 / output.Width)
			local padding = math.min(math.max(value_of(r.padding), 0), size * 0.45)
			-- Fit inside a circle so the transparent trace stays within the
			-- template's circular container even for diagonal route bounds.
			local extent = math.max(size - 2 * padding, 1 / output.Width) / math.sqrt(2)
			local cx, cy = position.X, position.Y * aspect
			local width = math.max(value_of(r.width), 1 / output.Width)
			local parts = {}
			local function point(x, y) return cx + x * extent, cy + y * extent end
			local function dot(x, y, diameter, color)
				local px, py = point(x, y)
				table.insert(parts, {shapes = {capsule(px - diameter/2, py - diameter/2, diameter, diameter)}, color = color})
			end
			if route.count < 2 then
				local text = "NO GPS"
				local font_size = math.min(size / 8, 0.02)
				table.insert(parts, {font = widget_font, style = widget_style, text = text, size = font_size,
					x = cx - text_width(widget_font, widget_style, text, font_size)/2, y = cy, color = Pixel{R=1,G=1,B=1,A=1}})
			else
				for _, path in ipairs(route.paths) do
					if #path >= 2 then
						local shape = Shape()
						for index, p in ipairs(path) do
							local x, y = point(p.x, p.y)
							if index == 1 then shape:MoveTo(x, y) else shape:LineTo(x, y) end
						end
						table.insert(parts, {shapes = {shape:OutlineOfShape(width, "OLT_Solid", "OJT_Round", 8, "SWM_Normal", 8)}, color = color_of(r.color)})
					end
				end
				if value_of(r.endpoints) > 0.5 then
					local first, last = route.paths[1][1], route.paths[#route.paths][#route.paths[#route.paths]]
					dot(first.x, first.y, width * 2, color_of(r.color))
					dot(last.x, last.y, width * 3, color_of(r.color))
				end
				if value_of(r.marker) > 0.5 and sample.route_x ~= nil and sample.route_y ~= nil then
					local diameter = math.max(value_of(r.marker_size), width * 2)
					dot(sample.route_x, sample.route_y, diameter + 2/output.Width, Pixel{R=1,G=1,B=1,A=1})
					dot(sample.route_x, sample.route_y, diameter, color_of(r.marker_color))
				end
			end
			local shadow = shadow_of(options)
			if shadow ~= nil then draw_shadow(output, parts, shadow, quality) end
			for _, part in ipairs(parts) do draw_part(output, part, part.color, 0, 0, quality) end
		end
		local function render_zone(position, widget_font, widget_style, z, options)
			local count = math.floor(value_of(z.count) + 0.5) == 0 and 5 or 6
			local ranges = {}
			for index=1,count do ranges[index] = {math.floor(value_of(z.ranges[index][1])+0.5), math.floor(value_of(z.ranges[index][2])+0.5)} end
			local active, fraction = heart_rate_zone(sample.heart_rate, ranges)
			local frames = zone_frames(count, active, value_of(z.active_share))
			local placement = math.floor(value_of(z.placement)+0.5)
			local vertical = placement == 2 or placement == 3 or (placement == 4 and value_of(z.orientation)>0.5)
			local length = math.max(1/output.Width, math.min(value_of(z.length), vertical and aspect or 1))
			local thickness = math.max(value_of(z.thickness), 1/output.Width)
			local inset = math.max(value_of(z.inset),0)
			local cx, cy = position.X, position.Y*aspect
			local sign = 1
			if placement == 0 then cx,cy=0.5,inset+thickness/2
			elseif placement == 1 then cx,cy,sign=0.5,aspect-inset-thickness/2,-1
			elseif placement == 2 then cx,cy=inset+thickness/2,aspect/2
			elseif placement == 3 then cx,cy,sign=1-inset-thickness/2,aspect/2,-1 end
			local gap = math.min(math.max(value_of(z.gap),0), length/(count-1)*0.18)
			local usable = math.max(length-gap*(count-1),1/output.Width)
			local parts, active_part, rects = {}, nil, {}
			local function tint(index, opacity)
				local c=HR_ZONE_COLORS[index];return Pixel{R=c[1],G=c[2],B=c[3],A=opacity or 1}
			end
			local function rectangle(x,y,w,h,color,corner)
				local part={shapes={capsule(x,y,w,h,corner)},color=color};table.insert(parts,part);return part
			end
			local function text(value,x,y,size,color)
				local ascent,descent=font_extents(widget_font,widget_style,size)
				table.insert(parts,{font=widget_font,style=widget_style,text=value,size=size,
					x=x-text_width(widget_font,widget_style,value,size)/2,y=y+(descent-ascent)/2,color=color})
			end
			for index, frame in ipairs(frames) do
				local start = -length/2+usable*frame.start+(index-1)*gap
				local run = usable*frame.width
				local thick = thickness*(index==active and math.max(value_of(z.active_height),1) or 1)
				local x,y,w,h
				if vertical then x,y,w,h=cx-thick/2,cy+start,thick,run
				else x,y,w,h=cx+start,cy-thick/2,run,thick end
				rects[index]={x=x,y=y,w=w,h=h}
				local part=rectangle(x,y,w,h,tint(index,index==active and 1 or math.min(math.max(value_of(z.inactive),0),1)),math.max(value_of(z.corner),0))
				if index==active then active_part=part end
				if value_of(z.labels)>0.5 then text("Z"..index,x+w/2,y+h/2,math.min(value_of(z.text_size),thickness*0.75),Pixel{R=1,G=1,B=1,A=1}) end
			end
			if value_of(z.border)>0.5 then
				local x,y,w,h=cx-length/2,cy-thickness/2,length,thickness
				if vertical then x,y,w,h=cx-thickness/2,cy-length/2,thickness,length end
				local border=capsule(x,y,w,h,math.max(value_of(z.corner),0))
				table.insert(parts,{shapes={border:OutlineOfShape(math.max(value_of(z.border_width),1/output.Width),"OLT_Solid","OJT_Round",8,"SWM_Normal",8)},color=Pixel{R=1,G=1,B=1,A=value_of(z.border_opacity)}})
			end
			local function marker(index, f, threshold)
				local r=rects[index];local color=tint(index,threshold and 0.78 or 1)
				local along=vertical and r.y+r.h*f or r.x+r.w*f
				local cross=vertical and cx or cy
				local px,py=vertical and cross or along,vertical and along or cross
				local text_size=math.max(value_of(z.text_size)*(threshold and 0.72 or 1),7/1280)
				if threshold then
					local span=math.max(thickness*1.35,10/1280)
					if vertical then rectangle(cx-span/2,along-0.6/1280,span,1.2/1280,color)
					else rectangle(along-0.6/1280,cy-span/2,1.2/1280,span,color) end
					local tx,ty=px,py
					if vertical then tx=tx+sign*(span/2+text_width(widget_font,widget_style,"T",text_size)/2+2/1280)
					else ty=ty+sign*(span/2+text_size/2+2/1280) end
					text("T",tx,ty,text_size,color)
				else
					local half=math.max(thickness*1.35,12/1280)/2
					local high=math.max(thickness*0.9,8/1280)
					local near=cross+sign*(thickness/2+math.max(thickness*0.35,3/1280))
					local shape=Shape()
					if vertical then
						shape:MoveTo(near,along);shape:LineTo(near+sign*high,along-half);shape:LineTo(near+sign*high,along+half)
					else
						shape:MoveTo(along,near);shape:LineTo(along-half,near+sign*high);shape:LineTo(along+half,near+sign*high)
					end
					shape:Close();table.insert(parts,{shapes={shape},color=color})
					if value_of(z.show_value)>0.5 then
						local value=string.format("%d bpm",math.floor(sample.heart_rate+0.5))
						local tx,ty=px,py
						if vertical then tx=near+sign*(high+text_width(widget_font,widget_style,value,text_size)/2+4/1280)
						else ty=near+sign*(high+text_size/2+3/1280) end
						text(value,tx,ty,text_size,color)
					end
				end
			end
			if value_of(z.threshold_enabled)>0.5 then
				local index, f=heart_rate_zone(value_of(z.threshold),ranges)
				if index then marker(index,f,true) end
			end
			if active and value_of(z.marker)>0.5 then marker(active,fraction,false) end
			if active_part and value_of(z.glow)>0.5 then
				draw_layers(output,{active_part},{{opacity=value_of(z.glow_intensity),radius=thickness*1.6}},active_part.color,0,0,quality)
			end
			local shadow=shadow_of(options)
			if shadow then draw_shadow(output,parts,shadow,quality) end
			for _,part in ipairs(parts) do draw_part(output,part,part.color,0,0,quality) end
		end
		local function render_elevation(position,widget_font,widget_style,e,options)
			local profile=data.elevation or {values={}}
			local smoothing=value_of(e.smoothing)>0.5
			local values=smoothing and profile.smoothed or profile.values
			values=values or {}
			local geometry=profile[smoothing and "smooth" or "raw"] or {points={},bands={}}
			local width,height=math.max(value_of(e.width),2/output.Width),math.max(value_of(e.height),2/output.Width)
			local padding_x,padding_y=math.min(math.max(value_of(e.padding_x),0),width*0.45),math.min(math.max(value_of(e.padding_y),0),height*0.45)
			local left,bottom=position.X-width/2+padding_x,position.Y*aspect-height/2+padding_y
			local w,h=width-2*padding_x,height-2*padding_y
			local opacity=math.min(math.max(value_of(e.opacity),0),1)
			local parts={}
			local function polygon(points)
				local shape=Shape()
				for index,p in ipairs(points) do
					if index==1 then shape:MoveTo(left+w*p.x,bottom+h*p.y) else shape:LineTo(left+w*p.x,bottom+h*p.y) end
				end
				shape:Close();return shape
			end
			local function part(shape,color,sampling) table.insert(parts,{shapes={shape},color=color,sampling=sampling}) end
			local function text(value,x,y,size)
				table.insert(parts,{font=widget_font,style=widget_style,text=value,size=size,
					x=x-text_width(widget_font,widget_style,value,size)/2,y=y,color=Pixel{R=1,G=1,B=1,A=opacity}})
			end
			if #values==0 then
				text("NO ELEVATION",position.X,bottom+h/2,math.min(height/4,0.018))
			else
				if value_of(e.fill)>0.5 and #values>1 then
					local top_color,bottom_color=color_of(e.fill_color),color_of(e.lower_color)
					local fill_opacity=value_of(e.fill_opacity)
					for index,points in ipairs(geometry.bands) do
						if #points>=3 then
							local f=(index-0.5)/24
							local alpha=math.max(fill_opacity*0.15,0.04)+(fill_opacity-math.max(fill_opacity*0.15,0.04))*f
							if fill_opacity<=0 then alpha=0 end
							part(polygon(points),Pixel{R=bottom_color.R+(top_color.R-bottom_color.R)*f,
								G=bottom_color.G+(top_color.G-bottom_color.G)*f,B=bottom_color.B+(top_color.B-bottom_color.B)*f,A=alpha*opacity},1)
						end
					end
				end
				local line=Shape()
				if #geometry.points==1 then line:MoveTo(left,bottom+h/2);line:LineTo(left+w,bottom+h/2)
				else for index,p in ipairs(geometry.points) do
					if index==1 then line:MoveTo(left+w*p.x,bottom+h*p.y) else line:LineTo(left+w*p.x,bottom+h*p.y) end
				end end
				local color=color_of(e.line);color.A=color.A*opacity
				part(line:OutlineOfShape(math.max(value_of(e.line_width),0.5/output.Width),"OLT_Solid","OJT_Round",8,"SWM_Normal",8),color)
				local mx,my=elevation_marker(values,elapsed_us,data.duration_us)
				if mx~=nil and value_of(e.marker)>0.5 and sample.elevation_m~=nil then
					local x,y=left+w*mx,bottom+h*my
					local marker_color=color_of(e.marker_color,opacity)
					local size=8/1280*value_of(e.marker_size)
					if value_of(e.guide)>0.5 and mx>0 then
						local guide=Shape()
						for i=0,7 do
							local dy=(y-bottom)*i/8
							guide:AddRectangle(x-0.5/output.Width,x+0.5/output.Width,bottom+dy+(y-bottom)/16,bottom+dy,0,8)
						end
						part(guide,Pixel{R=marker_color.R,G=marker_color.G,B=marker_color.B,A=opacity*0.4})
					end
					part(capsule(x-size/2,y-size/2,size,size),marker_color)
					local ring=capsule(x-size*13/16,y-size*13/16,size*13/8,size*13/8)
					part(ring:OutlineOfShape(2/1280,"OLT_Solid","OJT_Round",8,"SWM_Normal",8),Pixel{R=1,G=1,B=1,A=opacity*0.85})
				end
				if value_of(e.show_value)>0.5 then
					local value=sample.elevation_m~=nil and string.format("%d m",round(sample.elevation_m)) or "-- m"
					text(value,position.X,bottom+h+2/1280,12/1280)
				end
			end
			local shadow=shadow_of(options)
			if shadow then draw_shadow(output,parts,shadow,quality) end
			for _,p in ipairs(parts) do draw_part(output,p,p.color,0,0,quality) end
		end
		local function render_weather(position, widget_font, widget_style, w, options)
			local weather = data.weather
			local pixel = 1 / output.Width
			local width, height = math.max(value_of(w.width), 2 * pixel), math.max(value_of(w.height), 2 * pixel)
			local padding = math.min(math.max(value_of(w.padding), 0), width * 0.2, height * 0.3)
			local corner = math.min(math.max(value_of(w.corner), 0), height / 2)
			local left, bottom = position.X - width / 2, position.Y * aspect - height / 2
			local opacity = math.min(math.max(value_of(w.opacity), 0), 1)
			local text_color = color_of(w.text)
			local parts = {}
			local function part(shape, color, sampling) table.insert(parts, {shapes = {shape}, color = color, sampling = sampling}) end
			-- Approximate the template's diagonal blue glass with horizontal bands.
			-- Each band insets to the rounded corner so the card edge stays clean.
			if value_of(w.background) > 0.5 and opacity > 0 then
				local top, lower = color_of(w.top_color), color_of(w.bottom_color)
				for band = 1, 16 do
					local y0, y1 = bottom + height * (band - 1) / 16, bottom + height * band / 16
					local f = (band - 0.5) / 16
					local inset = 0
					if corner > 0 then
						local depth = math.min(y0, height - y1)
						if depth < corner then inset = corner - math.sqrt(math.max(corner * corner - (corner - depth) * (corner - depth), 0)) end
					end
					local band_shape = Shape()
					band_shape:AddRectangle(left + inset, left + width - inset, y0, y1, 0, 8)
					part(band_shape, Pixel{R = lower.R + (top.R - lower.R) * f, G = lower.G + (top.G - lower.G) * f,
						B = lower.B + (top.B - lower.B) * f, A = opacity}, 1)
				end
			end
			if value_of(w.border) > 0.5 then
				local border = color_of(w.border_color, value_of(w.border_opacity) * opacity)
				part(capsule(left, bottom, width, height, corner):OutlineOfShape(math.max(pixel, 0.5 * pixel), "OLT_Solid", "OJT_Round", 8, "SWM_Normal", 8), border)
			end
			local inner_left, inner_bottom = left + padding, bottom + padding
			local inner_width, inner_height = width - 2 * padding, height - 2 * padding
			local left_width = inner_width * 0.4
			local right_left = inner_left + left_width + padding
			local right_width = inner_width - left_width - padding
			local condition = weather and weather.condition or "sunny"
			local label = WEATHER_LABELS[condition] or WEATHER_LABELS.sunny
			local icon_name = WEATHER_LABELS[condition] and condition or "sunny"
			if icon_name == "clearNight" then icon_name = "Clear night"
			elseif icon_name == "partlyCloudy" then icon_name = "Partly cloudy"
			elseif icon_name == "heavyRain" then icon_name = "Heavy rain"
			else icon_name = label end
			local function fit_size(value, max_size, max_width)
				if value == "" or max_width <= 0 then return max_size end
				local measured = text_width(widget_font, widget_style, value, max_size)
				if measured <= max_width then return max_size end
				return math.max(max_size * 0.55, max_size * max_width / measured)
			end
			if value_of(w.show_condition) > 0.5 then
				local size = fit_size(label, value_of(w.condition_size), left_width)
				local ascent, descent = font_extents(widget_font, widget_style, size)
				local width_of = text_width(widget_font, widget_style, label, size)
				table.insert(parts, {font = widget_font, style = widget_style, text = label, size = size,
					x = inner_left + (left_width - width_of) / 2, y = inner_bottom + inner_height - ascent, color = text_color})
			end
			if value_of(w.show_icon) > 0.5 and ICON_GLYPHS[icon_name] ~= nil then
				local icon_size = math.min(value_of(w.icon_size), left_width, inner_height)
				table.insert(parts, {shapes = icon_shapes(icon_name, inner_left + (left_width - icon_size) / 2, inner_bottom + icon_size * 0.45, icon_size), color = text_color})
			end
			if value_of(w.divider) > 0.5 then
				local divider_shape = Shape()
				divider_shape:AddRectangle(right_left - padding / 2 - 0.5 * pixel, right_left - padding / 2 + 0.5 * pixel,
					inner_bottom, inner_bottom + inner_height, 0, 8)
				part(divider_shape, color_of(w.divider_color, value_of(w.divider_opacity) * opacity))
			end
			local temperature = weather and weather.temperatureC or nil
			if temperature ~= nil and value_of(w.fit_override) > 0.5 and sample.temperature_c ~= nil then temperature = sample.temperature_c end
			local units = math.floor(value_of(w.units) + 0.5)
			local temperature_text = "--"
			if temperature ~= nil and weather ~= nil then
				if units == 1 then temperature_text = string.format("%d", math.floor(temperature * 9 / 5 + 32 + 0.5)) .. "\194\176"
				else temperature_text = string.format("%d", math.floor(temperature + 0.5)) .. "\194\176" end
			end
			local secondary = Pixel{R = text_color.R, G = text_color.G, B = text_color.B, A = opacity * value_of(w.secondary_opacity)}
			local rows = {}
			if value_of(w.show_location) > 0.5 then table.insert(rows, {text = weather and weather.location or "--", size = value_of(w.location_size), color = secondary}) end
			if value_of(w.show_weekday) > 0.5 then table.insert(rows, {text = weather and weather.weekday or "--", size = value_of(w.secondary_size), color = secondary}) end
			table.insert(rows, {text = temperature_text, size = value_of(w.temperature_size), color = text_color})
			if value_of(w.show_humidity) > 0.5 then
				local humidity = weather and weather.humidity
				table.insert(rows, {text = humidity ~= nil and string.format("%d%% RH", humidity) or "-- RH", size = value_of(w.secondary_size), color = secondary})
			end
			local cursor = inner_bottom + inner_height
			for _, row in ipairs(rows) do
				local size = fit_size(row.text, row.size, right_width)
				local ascent, descent = font_extents(widget_font, widget_style, size)
				cursor = cursor - (ascent + descent) - 1.5 / 1280
				table.insert(parts, {font = widget_font, style = widget_style, text = row.text, size = size,
					x = right_left, y = cursor + descent, color = row.color})
			end
			local shadow = shadow_of(options)
			if shadow ~= nil then draw_shadow(output, parts, shadow, quality) end
			for _, item in ipairs(parts) do draw_part(output, item, item.color, 0, 0, quality) end
		end
		local function render_decor(metric, position, widget_font, widget_style, color, d)
			local x, y = position.X, position.Y * aspect
			local parts = {}
			local function part(shape, pixel) table.insert(parts, {shapes = {shape}, color = pixel}) end
			if metric == DECOR_SOLID_METRIC then
				local width = math.max(value_of(d.width), 1 / output.Width)
				local height = math.max(value_of(d.height), 1 / output.Width)
				local kind = math.floor(value_of(d.shape) + 0.5)
				local shape
				if kind == 2 then
					local side = math.min(width, height)
					width, height = side, side
					shape = capsule(x - width / 2, y - height / 2, width, height, side / 2)
				elseif kind == 1 then
					shape = capsule(x - width / 2, y - height / 2, width, height,
						math.min(value_of(d.corner), width / 2, height / 2))
				else
					shape = Shape()
					shape:AddRectangle(x - width / 2, x + width / 2, y - height / 2, y + height / 2, 0, 8)
				end
				part(shape, color_of(d.fill))
			elseif metric == DECOR_ICON_METRIC then
				local size = math.max(value_of(d.icon_size), 4 / output.Width)
				local name = DECOR_ICON_NAMES[math.floor(value_of(d.icon) + 0.5) + 1] or "Heart"
				for _, shape in ipairs(icon_shapes(name, x - size / 2, y + size / 2, size)) do
					part(shape, color_of(d.icon_color))
				end
			elseif metric == DECOR_TEXT_METRIC then
				local text = tostring(value_of(d.text) or ""):gsub("[\r\n]+", " ")
				if text ~= "" then
					local text_size = math.max(value_of(d.text_size), 0.003)
					local width = text_width(widget_font, widget_style, text, text_size)
					local alignment = math.floor(value_of(d.alignment) + 0.5)
					local left = alignment == 0 and x or (alignment == 2 and x - width or x - width / 2)
					table.insert(parts, {font = widget_font, style = widget_style, text = text, size = text_size,
						x = left, y = y, color = color_of(d.text_color)})
				end
			end
			for _, item in ipairs(parts) do draw_part(output, item, item.color, 0, 0, quality) end
		end
		local function render_gauge(position, widget_font, widget_style, color, g)
			local radius = math.max(value_of(g.size), 0.01) / 2
			local cx, cy = position.X, position.Y * aspect
			local parts = {}
			local function part(shape, pixel) table.insert(parts, {shapes = {shape}, color = pixel}) end
			local function disc(r, pixel, width)
				local shape = capsule(cx - r, cy - r, r * 2, r * 2, r)
				if width ~= nil then
					shape = shape:OutlineOfShape(math.max(width, 1 / output.Width), "OLT_Solid", "OJT_Round", 12, "SWM_Normal", 12)
				end
				part(shape, pixel)
			end
			if value_of(g.dial) > 0.5 then
				disc(radius, color_of(g.dial_color, value_of(g.dial_opacity)))
			end
			local ring_width = math.max(value_of(g.ring_width) * radius, 1 / output.Width)
			if value_of(g.ring) > 0.5 then
				disc(radius, color_of(g.ring_color, value_of(g.ring_opacity)), ring_width)
			end
			if value_of(g.ticks) > 0.5 then
				local count = math.min(math.max(math.floor(value_of(g.tick_count) + 0.5), 6), 120)
				local every = math.min(math.max(math.floor(value_of(g.tick_every) + 0.5), 1), count)
				local outer = radius - ring_width - 2 / output.Width
				for index = 0, count - 1 do
					local major = index % every == 0
					local angle = -math.pi / 2 + index / count * 2 * math.pi
					local inner = outer - radius * (major and 0.055 or 0.030)
					local half = radius * (major and 0.008 or 0.004)
					local dx, dy = math.cos(angle), math.sin(angle)
					local px, py = -dy * half, dx * half
					local shape = Shape()
					shape:MoveTo(cx + dx * inner + px, cy + dy * inner + py)
					shape:LineTo(cx + dx * outer + px, cy + dy * outer + py)
					shape:LineTo(cx + dx * outer - px, cy + dy * outer - py)
					shape:LineTo(cx + dx * inner - px, cy + dy * inner - py)
					shape:Close()
					part(shape, Pixel{R = 1, G = 1, B = 1, A = major and value_of(g.major_opacity) or value_of(g.tick_opacity)})
				end
			end
			local mode = math.floor(value_of(g.progress) + 0.5)
			if mode > 0 then
				local progress_width = math.max(value_of(g.progress_width) * radius, 1 / output.Width)
				local ring_radius = radius - ring_width - progress_width - 2 / output.Width
				disc(ring_radius, color_of(g.progress_track, value_of(g.progress_track_opacity)), progress_width)
				local fraction = 0
				if mode == 1 then
					fraction = (data.total_distance_m and data.total_distance_m > 0 and sample.distance_m) and sample.distance_m / data.total_distance_m or 0
				elseif mode == 2 then
					fraction = (data.duration_us and data.duration_us > 0) and elapsed_us / data.duration_us or 0
				elseif mode == 7 then
					fraction = 0.5
				else
					fraction = (data.duration_us and data.duration_us > 0) and elapsed_us / data.duration_us or 0
				end
				fraction = math.min(math.max(fraction, 0), 1)
				if fraction > 0 then
					local steps = math.max(2, math.ceil(2 * math.pi * fraction / (math.pi / 48)))
					local shape = Shape()
					local function at(r, angle)
						local px = cx + r * math.cos(angle)
						local py = cy + r * math.sin(angle)
						return px, py
					end
					local from, to = -math.pi / 2, -math.pi / 2 + 2 * math.pi * fraction
					for index = 0, steps do
						local px, py = at(ring_radius + progress_width / 2, from + (to - from) * index / steps)
						if index == 0 then shape:MoveTo(px, py) else shape:LineTo(px, py) end
					end
					for index = steps, 0, -1 do
						local px, py = at(ring_radius - progress_width / 2, from + (to - from) * index / steps)
						shape:LineTo(px, py)
					end
					shape:Close()
					part(shape, color_of(g.progress_color))
				end
			end
			if value_of(g.dividers) > 0.5 then
				local half_width = radius * 0.62
				local height = math.max(radius * 0.004, 1 / output.Width)
				for _, offset in ipairs({-radius * 0.34, radius * 0.34}) do
					local shape = Shape()
					shape:AddRectangle(cx - half_width, cx + half_width, cy + offset - height / 2, cy + offset + height / 2, 0, 8)
					part(shape, color_of(g.divider_color, value_of(g.divider_opacity)))
				end
			end
			local accent = color_of(g.accent_color, 0.78)
			local function region(metric, x, y, scale)
				local label, value, unit = metric_text(metric, sample, elapsed_us, data, metric == 3 and 1 or 0,
					nil, nil, 0, nil, nil, nil, nil, nil)
				local value_size = radius * scale
				local label_size = radius * 0.12
				local unit_size = radius * 0.11
				local short_label = GAUGE_LABELS[metric] or label
				local width = text_width(widget_font, widget_style, value, value_size)
				table.insert(parts, {font = widget_font, style = widget_style, text = value, size = value_size,
					x = x - width / 2, y = y, color = color})
				if value_of(g.labels) > 0.5 then
					local label_width = text_width(widget_font, widget_style, short_label, label_size)
					table.insert(parts, {font = widget_font, style = widget_style, text = short_label, size = label_size,
						x = x - label_width / 2, y = y + value_size * 0.52 + label_size * 0.9, color = accent})
				end
				if unit ~= "" then
					local unit_width = text_width(widget_font, widget_style, unit, unit_size)
					table.insert(parts, {font = widget_font, style = widget_style, text = unit, size = unit_size,
						x = x - unit_width / 2, y = y - value_size * 0.52 - unit_size * 0.9, color = accent})
				end
			end
			local function metric_at(combo) return GAUGE_METRICS[math.floor(value_of(combo) + 0.5) + 1] or 2 end
			region(metric_at(g.top_metric), cx, cy + radius * 0.46, 0.34)
			region(metric_at(g.middle_left_metric), cx - radius * 0.42, cy, 0.22)
			region(metric_at(g.middle_right_metric), cx + radius * 0.42, cy, 0.22)
			region(metric_at(g.bottom_metric), cx, cy - radius * 0.46, 0.22)
			for _, item in ipairs(parts) do draw_part(output, item, item.color, 0, 0, quality) end
		end
		local LAP_KIND_COLORS = {
			warmup = {58 / 255, 166 / 255, 163 / 255},
			active = {231 / 255, 122 / 255, 60 / 255},
			rest = {79 / 255, 130 / 255, 199 / 255},
			cooldown = {122 / 255, 106 / 255, 216 / 255},
		}
		local UNKNOWN_LAP_COLOR = {0.25, 0.82, 0.38}
		local function lap_kind_color(kind)
			return LAP_KIND_COLORS[kind] or UNKNOWN_LAP_COLOR
		end
		local function interval_phase_label(kind)
			return ({warmup = "WU", active = "WORK", rest = "REST", cooldown = "CD"})[kind] or "LAP"
		end
		local function interval_time_text(seconds)
			local total = math.max(0, math.floor((seconds or 0) + 0.5))
			local hours = math.floor(total / 3600)
			if hours > 0 then return string.format("%d:%02d:%02d", hours, math.floor(total / 60) % 60, total % 60) end
			return string.format("%d:%02d", math.floor(total / 60), total % 60)
		end
		local function interval_distance_text(meters)
			meters = math.max(meters or 0, 0)
			if meters >= 1000 then return string.format("%.2f km", meters / 1000) end
			return string.format("%d m", math.floor(meters + 0.5))
		end
		local function all_laps() return data.laps or {} end
		local function lap_end_us(lap)
			if lap.end_us ~= nil then return lap.end_us end
			local next_start = nil
			for _, candidate in ipairs(all_laps()) do
				if candidate.start_us > lap.start_us and (next_start == nil or candidate.start_us < next_start) then next_start = candidate.start_us end
			end
			return next_start or data.duration_us or lap.start_us
		end
		local function current_lap(real_us)
			local found = nil
			for _, lap in ipairs(all_laps()) do
				if lap.start_us <= real_us then found = lap end
			end
			return found
		end
		local function lap_total_distance(lap)
			if lap.total_distance_m ~= nil and lap.total_distance_m > 0 then return lap.total_distance_m end
			local next_start = nil
			for _, candidate in ipairs(all_laps()) do
				if candidate.start_us > lap.start_us and (next_start == nil or candidate.start_us < next_start) then next_start = candidate.start_us end
			end
			if next_start ~= nil then
				for _, candidate in ipairs(all_laps()) do
					if candidate.start_us == next_start and candidate.start_distance_m ~= nil and lap.start_distance_m ~= nil then
						return math.max(candidate.start_distance_m - lap.start_distance_m, 0)
					end
				end
			end
			return data.total_distance_m or 0
		end
		local function lap_values(lap, real_us)
			local start_us = lap and lap.start_us or 0
			local end_us = lap and lap_end_us(lap) or (data.duration_us or 0)
			local elapsed_s = math.max((real_us - start_us) / 1000000, 0)
			local remaining_s = math.max((end_us - real_us) / 1000000, 0)
			local total_s = math.max((end_us - start_us) / 1000000, 0)
			local inlap_m = sample and sample.distance_m and math.max(sample.distance_m - (lap and lap.start_distance_m or 0), 0) or 0
			local total_m = lap and lap_total_distance(lap) or (data.total_distance_m or 0)
			local remaining_m = math.max(total_m - inlap_m, 0)
			local time_progress = total_s > 0 and math.min(math.max(elapsed_s / total_s, 0), 1) or 0
			local distance_progress = total_m > 0 and math.min(math.max(inlap_m / total_m, 0), 1) or 0
			return {elapsed_s = elapsed_s, remaining_s = remaining_s, total_s = total_s, inlap_m = inlap_m,
				total_m = total_m, remaining_m = remaining_m, time_progress = time_progress, distance_progress = distance_progress}
		end
		local function rep_text(lap)
			local active = {}
			for _, candidate in ipairs(all_laps()) do if candidate.kind == "active" then table.insert(active, candidate) end end
			if #active == 0 then return "-- / --" end
			if lap == nil then return "1 / " .. #active end
			if lap.kind == "active" then
				for index, candidate in ipairs(active) do if candidate.start_us == lap.start_us then return index .. " / " .. #active end end
			end
			local completed = 0
			for _, candidate in ipairs(active) do if lap_end_us(candidate) <= lap.start_us then completed = completed + 1 end end
			return math.min(completed + 1, #active) .. " / " .. #active
		end
		local function pixel_of(value)
			if value == nil then return Pixel{R = 1, G = 1, B = 1, A = 1} end
			if value.R ~= nil then return Pixel{R = value.R, G = value.G, B = value.B, A = value.A or 1} end
			return value
		end
		local function add_text(parts, font, style, text, size, x, y, pixel, alignment)
			local width = text_width(font, style, text, size)
			if alignment == "center" then x = x - width / 2 elseif alignment == "right" then x = x - width end
			table.insert(parts, {font = font, style = style, text = text, size = size, x = x, y = y, color = pixel})
		end
		local function render_interval_hud(position, widget_font, widget_style, h)
			local width = math.max(value_of(h.width), 0.02)
			local height = math.max(value_of(h.height), 0.01)
			local cx, cy = position.X, position.Y * aspect
			local left, bottom = cx - width / 2, cy - height / 2
			local pad = height * 0.12
			local lap = current_lap(elapsed_us)
			local values = lap_values(lap, elapsed_us)
			local kind = lap and lap.kind or "unknown"
			local phase_color = Pixel{R = lap_kind_color(kind)[1], G = lap_kind_color(kind)[2], B = lap_kind_color(kind)[3], A = 1}
			local parts = {}
			if value_of(h.background_opacity) > 0 then
				table.insert(parts, {shapes = {capsule(left, bottom, width, height, value_of(h.corner))},
					color = color_of(h.background, value_of(h.background_opacity))})
			end
			local text_color = pixel_of(color)
			local bar_height = value_of(h.bar_height)
			local text_bottom = bottom + (value_of(h.bottom) > 0.5 and bar_height + pad * 0.6 or 0)
			local text_top = bottom + height
			if value_of(h.show_phase) > 0.5 then
				add_text(parts, widget_font, widget_style, interval_phase_label(kind), value_of(h.phase_size),
					left + pad, text_bottom + (text_top - text_bottom) * 0.62, phase_color, "left")
			end
			if value_of(h.show_rep) > 0.5 then
				add_text(parts, widget_font, widget_style, rep_text(lap), value_of(h.rep_size),
					left + width - pad, text_bottom + (text_top - text_bottom) * 0.64, text_color, "right")
			end
			if value_of(h.show_remaining) > 0.5 then
				local detail_mode = math.floor(value_of(h.detail_mode) + 0.5)
				if kind == "rest" then detail_mode = math.floor(value_of(h.rest_detail_mode) + 0.5) end
				local primary = detail_mode == 1 and interval_distance_text(values.remaining_m) or interval_time_text(values.remaining_s)
				local center_x = cx
				add_text(parts, widget_font, widget_style, "LEFT", value_of(h.label_size), center_x,
					text_bottom + (text_top - text_bottom) * 0.66, text_color, "center")
				add_text(parts, widget_font, widget_style, primary, value_of(h.value_size), center_x,
					text_bottom + (text_top - text_bottom) * 0.22, text_color, "center")
			end
			if value_of(h.bottom) > 0.5 then
				local bar_left, bar_width = left + pad, width - pad * 2
				local bar_bottom = bottom + pad * 0.9
				table.insert(parts, {shapes = {capsule(bar_left, bar_bottom, bar_width, bar_height, bar_height / 2)},
					color = color_of(h.bar_track, value_of(h.bar_track_opacity))})
				local progress = math.floor(value_of(h.progress_mode) + 0.5) == 1 and values.distance_progress or values.time_progress
				if progress > 0 then
					table.insert(parts, {shapes = {capsule(bar_left, bar_bottom, math.max(bar_width * progress, bar_height), bar_height, bar_height / 2)},
						color = phase_color})
				end
			end
			for _, item in ipairs(parts) do draw_part(output, item, item.color, 0, 0, quality) end
		end
		local function render_interval_timeline(position, widget_font, widget_style, t)
			local laps = all_laps()
			if #laps == 0 then return end
			local width = math.max(value_of(t.width), 0.02)
			local height = math.max(value_of(t.height), 0.01)
			local cx, cy = position.X, position.Y * aspect
			local left, bottom = cx - width / 2, cy - height / 2
			local pad = math.min(value_of(t.padding), height / 4)
			local gap = value_of(t.gap)
			local by_distance = math.floor(value_of(t.progress_mode) + 0.5) == 1
			local total = 0
			local weights = {}
			for _, lap in ipairs(laps) do
				local values = lap_values(lap, lap.start_us)
				local weight = by_distance and math.max(lap.total_distance_m or 0, 1) or math.max(values.total_s, 1)
				table.insert(weights, weight)
				total = total + weight
			end
			local parts = {}
			if value_of(t.background) > 0.5 then
				table.insert(parts, {shapes = {capsule(left, bottom, width, height, value_of(t.corner))},
					color = color_of(t.background_color, value_of(t.background_opacity))})
			end
			local inner = width - pad * 2 - gap * (#laps - 1)
			local x = left + pad
			local current = current_lap(elapsed_us)
			local current_values = current and lap_values(current, elapsed_us) or nil
			for index, lap in ipairs(laps) do
				local segment_width = math.max(inner * weights[index] / total, 1 / output.Width)
				local is_current = current ~= nil and lap.start_us == current.start_us
				local completed = lap_end_us(lap) <= elapsed_us
				local segment_height = height - pad * 2
				if is_current then segment_height = math.min(segment_height * value_of(t.current_scale), height - pad) end
				local segment_bottom = cy - segment_height / 2
				local opacity = is_current and 1 or (completed and value_of(t.completed_opacity) or value_of(t.future_opacity))
				local kind_color = lap_kind_color(lap.kind)
				table.insert(parts, {shapes = {capsule(x, segment_bottom, segment_width, segment_height, value_of(t.corner))},
					color = Pixel{R = kind_color[1], G = kind_color[2], B = kind_color[3], A = opacity}})
				if value_of(t.labels) > 0.5 then
					local values = lap_values(lap, lap.start_us)
					local label = by_distance and interval_distance_text(lap.total_distance_m or 0) or interval_time_text(values.total_s)
					local size = value_of(t.label_size)
					if text_width(widget_font, widget_style, label, size) < segment_width * 0.9 then
						add_text(parts, widget_font, widget_style, label, size, x + segment_width / 2, cy - size * 0.5,
							Pixel{R = 1, G = 1, B = 1, A = 0.9}, "center")
					end
				end
				x = x + segment_width + gap
			end
			if value_of(t.marker) > 0.5 and current ~= nil and current_values ~= nil then
				local progress = by_distance and current_values.distance_progress or current_values.time_progress
				local found_x = left + pad
				x = left + pad
				for index, lap in ipairs(laps) do
					local segment_width = math.max(inner * weights[index] / total, 1 / output.Width)
					if lap.start_us == current.start_us then found_x = x + segment_width * progress break end
					x = x + segment_width + gap
				end
				local marker = math.max(value_of(t.marker_size), 1 / output.Width)
				local marker_top = bottom + height + marker * 0.4
				local shape = Shape()
				shape:MoveTo(found_x - marker, marker_top)
				shape:LineTo(found_x + marker, marker_top)
				shape:LineTo(found_x, marker_top + marker * 1.4)
				shape:Close()
				table.insert(parts, {shapes = {shape}, color = color_of(t.marker_color)})
			end
			for _, item in ipairs(parts) do draw_part(output, item, item.color, 0, 0, quality) end
		end
		local function render_interval_countdown(position, widget_font, widget_style, c)
			local size = math.max(value_of(c.size), 0.02)
			local radius = size / 2
			local cx, cy = position.X, position.Y * aspect
			local lap = current_lap(elapsed_us)
			local values = lap_values(lap, elapsed_us)
			local kind = lap and lap.kind or "unknown"
			local group = lap_kind_color(kind)
			local ring_color = value_of(c.fill_follow) > 0.5 and Pixel{R = group[1], G = group[2], B = group[3], A = 1} or color_of(c.fill)
			local parts = {}
			local ring_width = math.max(value_of(c.ring_width), 1 / output.Width)
			local function disc(r, pixel, width)
				local shape = capsule(cx - r, cy - r, r * 2, r * 2, r)
				if width ~= nil then shape = shape:OutlineOfShape(math.max(width, 1 / output.Width), "OLT_Solid", "OJT_Round", 12, "SWM_Normal", 12) end
				table.insert(parts, {shapes = {shape}, color = pixel})
			end
			local track_radius = radius - ring_width / 2
			disc(track_radius, color_of(c.track, value_of(c.track_opacity)), ring_width)
			local clockwise = math.floor(value_of(c.direction) + 0.5) == 0
			local fraction = clockwise and 1 - values.time_progress or values.time_progress
			fraction = math.min(math.max(fraction, 0), 1)
			if fraction > 0 then
				local steps = math.max(2, math.ceil(2 * math.pi * fraction / (math.pi / 48)))
				local shape = Shape()
				local from = -math.pi / 2
				local to = from + 2 * math.pi * fraction
				for index = 0, steps do
					local angle = from + (to - from) * index / steps
					local px, py = cx + (track_radius + ring_width / 2) * math.cos(angle), cy + (track_radius + ring_width / 2) * math.sin(angle)
					if index == 0 then shape:MoveTo(px, py) else shape:LineTo(px, py) end
				end
				for index = steps, 0, -1 do
					local angle = from + (to - from) * index / steps
					shape:LineTo(cx + (track_radius - ring_width / 2) * math.cos(angle), cy + (track_radius - ring_width / 2) * math.sin(angle))
				end
				shape:Close()
				table.insert(parts, {shapes = {shape}, color = ring_color})
			end
			local metric_mode = math.floor(value_of(c.center_metric) + 0.5)
			local remaining_mode = math.floor(value_of(c.center_direction) + 0.5) == 0
			local center_text, caption
			if metric_mode == 1 then
				center_text = interval_distance_text(remaining_mode and values.remaining_m or values.inlap_m)
				caption = remaining_mode and "distance left" or "distance"
			else
				center_text = interval_time_text(remaining_mode and values.remaining_s or values.elapsed_s)
				caption = remaining_mode and "remaining" or "elapsed"
			end
			local phase_pixel = Pixel{R = group[1], G = group[2], B = group[3], A = 1}
			local text_color = pixel_of(color)
			if value_of(c.show_helper) > 0.5 then
				add_text(parts, widget_font, widget_style, "CURRENT SET", value_of(c.helper_size), cx, cy + size * 0.30, text_color, "center")
			end
			if value_of(c.show_phase) > 0.5 then
				add_text(parts, widget_font, widget_style, interval_phase_label(kind), value_of(c.phase_size), cx, cy + size * 0.18, phase_pixel, "center")
			end
			if value_of(c.show_rep) > 0.5 then
				add_text(parts, widget_font, widget_style, rep_text(lap), value_of(c.rep_size), cx, cy + size * 0.07, phase_pixel, "center")
			end
			add_text(parts, widget_font, widget_style, center_text, value_of(c.value_size), cx, cy - size * 0.18, text_color, "center")
			if value_of(c.show_caption) > 0.5 then
				add_text(parts, widget_font, widget_style, caption, value_of(c.caption_size), cx, cy - size * 0.33, text_color, "center")
			end
			for _, item in ipairs(parts) do draw_part(output, item, item.color, 0, 0, quality) end
		end
		local SUMMARY_LABELS = {"LAP TIME", "PACE", "DIST", "HR", "MAX HR", "POWER", "CAD"}
		local function summary_metric(index, lap, imperial)
			if lap == nil then return "--", "", SUMMARY_LABELS[index] or "" end
			if index == 1 then
				return interval_time_text(lap.total_elapsed_s or 0), "", SUMMARY_LABELS[1]
			elseif index == 2 then
				local seconds = lap.avg_pace_spk
				if (seconds == nil or seconds <= 0) and lap.total_distance_m and lap.total_distance_m > 0 then
					seconds = (lap.total_elapsed_s or 0) / (lap.total_distance_m / 1000)
				end
				local value, unit = pace_text(seconds, imperial and 1 or 0)
				return value, unit, SUMMARY_LABELS[2]
			elseif index == 3 then
				local meters = lap.total_distance_m or 0
				if imperial then return string.format("%.2f", meters / 1609.344), "mi", SUMMARY_LABELS[3] end
				if meters >= 1000 then return string.format("%.2f", meters / 1000), "km", SUMMARY_LABELS[3] end
				return string.format("%d", math.floor(meters + 0.5)), "m", SUMMARY_LABELS[3]
			elseif index == 4 then
				return lap.avg_hr and tostring(math.floor(lap.avg_hr + 0.5)) or "--", "bpm", SUMMARY_LABELS[4]
			elseif index == 5 then
				return "--", "bpm", SUMMARY_LABELS[5]
			elseif index == 6 then
				return lap.avg_power and tostring(math.floor(lap.avg_power + 0.5)) or "--", "W", SUMMARY_LABELS[6]
			elseif index == 7 then
				return lap.avg_cadence and tostring(math.floor(lap.avg_cadence + 0.5)) or "--", "spm", SUMMARY_LABELS[7]
			end
			return "--", "", ""
		end
		local function render_interval_summary(position, widget_font, widget_style, sm)
			local completed = nil
			for _, lap in ipairs(all_laps()) do
				if lap.kind == "active" and lap_end_us(lap) <= elapsed_us then completed = lap end
			end
			if completed == nil then return end
			local age = (elapsed_us - lap_end_us(completed)) / 1000000
			if age < 0 or age > math.max(value_of(sm.display_duration), 0) then return end
			local width = math.max(value_of(sm.width), 0.05)
			local height = math.max(value_of(sm.height), 0.02)
			local cx, cy = position.X, position.Y * aspect
			local left, bottom = cx - width / 2, cy - height / 2
			local pad = height * 0.12
			local group = lap_kind_color("active")
			local accent = value_of(sm.accent_follow) > 0.5 and Pixel{R = group[1], G = group[2], B = group[3], A = 1} or color_of(sm.accent)
			local text_color = pixel_of(color)
			local parts = {}
			table.insert(parts, {shapes = {capsule(left, bottom, width, height, value_of(sm.corner))},
				color = color_of(sm.background, value_of(sm.background_opacity))})
			local label = tostring(value_of(sm.component_label) or "")
			if label ~= "" then
				add_text(parts, widget_font, widget_style, label, value_of(sm.label_size), cx, bottom + height - pad - value_of(sm.label_size) * 1.2, accent, "center")
			end
			local imperial = math.floor(value_of(sm.units) + 0.5) == 1
			local primary_index = math.floor(value_of(sm.primary_metric) + 0.5) + 1
			local value, unit, metric_label = summary_metric(primary_index, completed, imperial)
			add_text(parts, widget_font, widget_style, value, value_of(sm.primary_size), cx, cy - height * 0.10, text_color, "center")
			if value_of(sm.primary_label) > 0.5 then
				add_text(parts, widget_font, widget_style, metric_label, value_of(sm.primary_label_size), cx,
					bottom + height * 0.30, accent, "center")
			end
			if value_of(sm.divider) > 0.5 then
				table.insert(parts, {shapes = {capsule(left + pad, bottom + height * 0.26, width - pad * 2, 1 / output.Width, 0)},
					color = Pixel{R = 1, G = 1, B = 1, A = value_of(sm.divider_opacity)}})
			end
			local slots = {math.floor(value_of(sm.secondary_1) + 0.5) + 1, math.floor(value_of(sm.secondary_2) + 0.5) + 1,
				math.floor(value_of(sm.secondary_3) + 0.5) + 1}
			for slot, index in ipairs(slots) do
				local x = left + pad + (width - pad * 2) * (slot - 0.5) / 3
				local slot_value, slot_unit, slot_label = summary_metric(index, completed, imperial)
				if slot_unit ~= "" then slot_value = slot_value .. " " .. slot_unit end
				add_text(parts, widget_font, widget_style, slot_value, value_of(sm.secondary_size), x, bottom + height * 0.13, text_color, "center")
				add_text(parts, widget_font, widget_style, slot_label, value_of(sm.secondary_label_size), x,
					bottom + height * 0.06, accent, "center")
			end
			for _, item in ipairs(parts) do draw_part(output, item, item.color, 0, 0, quality) end
		end
		local function render_slot(metric, position, size, show_label, widget_font, widget_style, color, options, timeline, route, zone, elevation, weather, gauge, decor, hud, interval_timeline, countdown, summary)
			if metric == DECOR_SOLID_METRIC or metric == DECOR_ICON_METRIC or metric == DECOR_TEXT_METRIC then
				render_decor(metric, position, widget_font, widget_style, color, decor)
			elseif sample == nil then
				return
			elseif metric == INTERVAL_HUD_METRIC then
				render_interval_hud(position, widget_font, widget_style, hud)
			elseif metric == INTERVAL_TIMELINE_METRIC then
				render_interval_timeline(position, widget_font, widget_style, interval_timeline)
			elseif metric == INTERVAL_COUNTDOWN_METRIC then
				render_interval_countdown(position, widget_font, widget_style, countdown)
			elseif metric == INTERVAL_SUMMARY_METRIC then
				render_interval_summary(position, widget_font, widget_style, summary)
			elseif metric == TIMELINE_METRIC then
				render_timeline(position, widget_font, widget_style, color, timeline, options)
			elseif metric == ROUTE_METRIC then
				render_route(position, widget_font, widget_style, route, options)
			elseif metric == ZONE_METRIC then
				render_zone(position, widget_font, widget_style, zone, options)
			elseif metric == ELEVATION_METRIC then
				render_elevation(position, widget_font, widget_style, elevation, options)
			elseif metric == WEATHER_METRIC then
				render_weather(position, widget_font, widget_style, weather, options)
			elseif metric == GAUGE_METRIC then
				render_gauge(position, widget_font, widget_style, color, gauge)
			else
				render_widget(metric, position, size, show_label, widget_font, widget_style, color, options, zone)
			end
		end
		if InHeartRateEnabled:GetValue(req).Value > 0.5 then
			render_slot(math.floor(InMetric:GetValue(req).Value + 0.5), InPosition:GetValue(req), InSize:GetValue(req).Value,
				InShowLabel:GetValue(req).Value > 0.5, font, style,
				Pixel{R = InR:GetValue(req).Value, G = InG:GetValue(req).Value,
					B = InB:GetValue(req).Value, A = InA:GetValue(req).Value}, PrimaryTextOptions, PrimaryTimelineOptions, PrimaryRouteOptions, PrimaryZoneOptions, PrimaryElevationOptions, PrimaryWeatherOptions, PrimaryGaugeOptions, PrimaryDecorOptions, PrimaryHudOptions, PrimaryIntervalTimelineOptions, PrimaryCountdownOptions, PrimarySummaryOptions)
		end
		for _, controls in ipairs(WidgetInputs) do
			if controls.enabled:GetValue(req).Value > 0.5 then
				local widget_font, widget_style = font_of(controls.font, controls.font_style)
				render_slot(math.floor(controls.metric:GetValue(req).Value + 0.5), controls.position:GetValue(req), controls.size:GetValue(req).Value,
					controls.label:GetValue(req).Value > 0.5, widget_font, widget_style, color_of(controls.color), controls.text, controls.timeline, controls.route, controls.zone, controls.elevation, controls.weather, controls.gauge, controls.decor, controls.hud, controls.interval_timeline, controls.countdown, controls.summary)
			end
		end
	elseif diagnostics_enabled then
		local detail = elapsed_us == nil
			and string.format("No sync segment at Resolve frame %d", timeline_frame)
			or string.format("No activity sample at %.3f s", elapsed_us / 1000000)
		draw_diagnostic(
			output, font, style, "RUNNING OVERLAY: NO DATA", detail, quality,
			Pixel{R = 1, G = 0.65, B = 0.15, A = 1}
		)
	end
	OutImage:Set(req, output)
end
