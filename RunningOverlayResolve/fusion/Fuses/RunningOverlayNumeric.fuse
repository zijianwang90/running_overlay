		local z = {
			count = combo_in(group, "Zone Count", key .. "ZoneCount", {"5", "6"}, 1),
			placement = combo_in(group, "Placement", key .. "ZonePlacement", {"Bottom", "Top", "Left", "Right", "Free"}, 0),
