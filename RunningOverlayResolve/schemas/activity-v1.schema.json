{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runningoverlay.example/schemas/resolve/activity-v1.schema.json",
  "title": "Running Overlay Resolve Activity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "activityId", "startUtcUs", "endUtcUs", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "activityId": { "type": "string", "minLength": 1 },
    "startUtcUs": { "type": "integer" },
    "endUtcUs": { "type": "integer" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["elapsedUs"],
        "properties": {
          "elapsedUs": { "type": "integer", "minimum": 0 },
          "distanceMeters": { "type": ["number", "null"] },
          "heartRateBpm": { "type": ["number", "null"] },
          "paceSecondsPerKilometer": { "type": ["number", "null"] },
          "cadenceSpm": { "type": ["number", "null"] },
          "elevationMeters": { "type": ["number", "null"] },
          "powerWatts": { "type": ["number", "null"] },
          "calories": { "type": ["number", "null"] },
          "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
          "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
          "routeSegment": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 }
        },
        "oneOf": [
          {
            "properties": {
              "latitude": { "type": "null" },
              "longitude": { "type": "null" },
              "routeSegment": { "type": "null" }
            }
          },
          {
            "required": ["latitude", "longitude", "routeSegment"],
            "properties": {
              "latitude": { "type": "number" },
              "longitude": { "type": "number" },
              "routeSegment": { "type": "integer" }
            }
          }
        ]
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "startElapsedUs", "endElapsedUs"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "startElapsedUs": { "type": "integer", "minimum": 0 },
          "endElapsedUs": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
