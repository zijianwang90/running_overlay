{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runningoverlay.example/schemas/resolve/timeline-scan-v1.schema.json",
  "title": "Running Overlay Resolve Timeline Scan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "timelineId",
    "timelineStartFrame",
    "timelineEndFrame",
    "frameRate",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "timelineId": {
      "type": "string",
      "minLength": 1
    },
    "timelineName": {
      "type": "string"
    },
    "timelineStartFrame": {
      "type": "integer"
    },
    "timelineEndFrame": {
      "type": "integer"
    },
    "frameRate": {
      "$ref": "#/$defs/rational"
    },
    "referenceVideoTrackIndex": {
      "type": "integer",
      "minimum": 1
    },
    "referenceVideoTrackName": {
      "type": "string"
    },
    "referenceVideoTrackEnabled": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timelineItemId",
          "mediaId",
          "cameraGroupId",
          "timelineStartFrame",
          "timelineEndFrameExclusive",
          "sourceStartFrame",
          "sourceFrameRate"
        ],
        "properties": {
          "timelineItemId": {
            "type": "string",
            "minLength": 1
          },
          "mediaId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "cameraGroupId": {
            "type": "string",
            "minLength": 1
          },
          "timelineStartFrame": {
            "type": "integer"
          },
          "timelineEndFrameExclusive": {
            "type": "integer"
          },
          "sourceStartFrame": {
            "type": "integer",
            "minimum": 0
          },
          "sourceFrameRate": {
            "$ref": "#/$defs/rational"
          },
          "speed": {
            "$ref": "#/$defs/rational"
          },
          "clipEnabled": {
            "type": "boolean"
          },
          "mappingIssue": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
