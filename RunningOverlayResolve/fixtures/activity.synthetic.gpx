<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Running Overlay Resolve synthetic test"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:tpx="http://www.garmin.com/xmlschemas/TrackPointExtension/v1"
     xmlns:ros="https://example.invalid/running-overlay-test">
  <trk><name>Synthetic run</name>
    <trkseg>
      <trkpt lat="0" lon="0">
        <ele>100</ele><time>2026-01-01T08:00:00.123456Z</time>
        <extensions><tpx:TrackPointExtension><tpx:hr>120</tpx:hr><tpx:cad>160</tpx:cad></tpx:TrackPointExtension><ros:speed>3</ros:speed></extensions>
      </trkpt>
      <trkpt lat="0" lon="0.0001">
        <ele>101</ele><time>2026-01-01T08:00:10.123456Z</time>
        <extensions><ros:power>250</ros:power></extensions>
      </trkpt>
    </trkseg>
    <trkseg>
      <trkpt lat="10" lon="10">
        <time>2026-01-01T08:00:20.123456Z</time>
        <extensions><tpx:TrackPointExtension><tpx:hr>140</tpx:hr></tpx:TrackPointExtension><ros:speed>2.5</ros:speed></extensions>
      </trkpt>
      <trkpt lat="10" lon="10.0001">
        <time>2026-01-01T08:00:30.123456Z</time>
        <extensions><tpx:TrackPointExtension><tpx:hr>150</tpx:hr></tpx:TrackPointExtension></extensions>
      </trkpt>
    </trkseg>
  </trk>
</gpx>
