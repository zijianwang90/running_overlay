{
  "spec": "ros.component/0.1",
  "id": "studio.interval-countdown",
  "version": "1.0.0",
  "name": {
    "en": "Interval Countdown",
    "zh-Hans": "间歇倒计时"
  },
  "description": {
    "en": "Current interval remaining time or distance with a progress ring.",
    "zh-Hans": "当前间歇的剩余时间或距离，带进度环。"
  },
  "author": "Running Overlay Studio",
  "license": "MIT",
