  "bindings": {
    "seg": {
      "signal": "structure.segment"
    }
  },
  "nodes": [
    {
      "type": "group",
      "frame": [
        0,
        0,
        "=size",
        "=size"
      ],
      "children": [
        {
          "type": "group",
          "if": "=backgroundEnabled",
          "frame": [
            0,
            0,
            "=size",
            "=size"
          ],
          "children": [
            {
              "type": "rect",
              "frame": [
                "=-backgroundPaddingX",
                "=-backgroundPaddingY",
                "=size + backgroundPaddingX * 2",
                "=size + backgroundPaddingY * 2"
              ],
              "radius": "=min(max(backgroundRadius, 0), min(size + backgroundPaddingX * 2, size + backgroundPaddingY * 2) / 2)",
              "fill": "=backgroundColor",
              "opacity": "=backgroundOpacity"
            },
            {
              "type": "rect",
              "if": "=borderEnabled",
              "frame": [
                "=-backgroundPaddingX",
                "=-backgroundPaddingY",
                "=size + backgroundPaddingX * 2",
                "=size + backgroundPaddingY * 2"
              ],
              "radius": "=min(max(backgroundRadius, 0), min(size + backgroundPaddingX * 2, size + backgroundPaddingY * 2) / 2)",
              "fill": "transparent",
              "stroke": "=borderColor",
              "strokeWidth": "=borderWidth",
              "opacity": "=borderOpacity"
            }
          ]
        },
        {
          "type": "group",
          "frame": [
            0,
            0,
            "=size",
            "=size"
          ],
          "children": [
            {
              "type": "group",
              "frame": [
                0,
                0,
                "=size",
                "=size"
              ],
              "children": [
                {
                  "type": "group",
                  "frame": [
                    0,
                    0,
                    "=size",
                    "=size"
                  ],
                  "opacity": "=trackOpacity",
                  "children": [
                    {
                      "type": "arc",
                      "frame": [
                        0,
                        0,
                        "=size",
                        "=size"
                      ],
                      "value": "=1",
                      "startDegrees": 0,
                      "sweepDegrees": 360,
                      "radius": "=max((size - ringWidth * 2) / 2, 0)",
                      "width": "=ringWidth",
                      "fillColor": "=trackColor",
                      "cap": "round",
                      "trackColor": "=trackColor"
                    }
                  ]
                },
                {
                  "type": "group",
                  "frame": [
                    0,
                    0,
                    "=size",
                    "=size"
                  ],
                  "children": [
                    {
                      "type": "arc",
                      "frame": [
                        0,
                        0,
                        "=size",
                        "=size"
                      ],
                      "value": "=ringDirection == \"clockwise\" ? 1 - seg.timeProgress : seg.timeProgress",
                      "startDegrees": -90,
                      "sweepDegrees": "=ringDirection == \"clockwise\" ? 360 : -360",
                      "radius": "=max((size - ringWidth * 2) / 2, 0)",
                      "width": "=ringWidth",
                      "fillColor": "=fillColorMode == \"followGroupColor\" ? seg.groupColor : fillColor",
                      "cap": "round"
                    }
                  ],
                  "shadows": [
                    {
                      "sigma": "=(ringGlowEnabled ? ringGlowIntensity * 16 : 0) / signal(\"host.scale\")",
                      "dx": 0,
                      "dy": 0,
                      "color": "=fillColorMode == \"followGroupColor\" ? seg.groupColor : fillColor",
                      "opacity": "=ringGlowEnabled ? ringGlowIntensity * 0.70 : 0"
                    },
                    {
                      "sigma": "=(ringGlowEnabled ? ringGlowIntensity * 28 : 0) / signal(\"host.scale\")",
                      "dx": 0,
                      "dy": 0,
                      "color": "=fillColorMode == \"followGroupColor\" ? seg.groupColor : fillColor",
                      "opacity": "=ringGlowEnabled ? ringGlowIntensity * 0.35 : 0"
                    }
                  ],
                  "shadowBounds": [
                    "=(ringWidth + ringWidth) / 2 - 90 / signal(\"host.scale\")",
                    "=(ringWidth + ringWidth) / 2 - 90 / signal(\"host.scale\")",
                    "=size - ringWidth * 2 + 180 / signal(\"host.scale\")",
                    "=size - ringWidth * 2 + 180 / signal(\"host.scale\")"
                  ]
                },
                {
                  "type": "textRows",
                  "frame": [
                    "=(size - (size - ringWidth * 3.6)) / 2",
                    "=(size - (size - ringWidth * 3.6)) / 2",
                    "=size - ringWidth * 3.6",
                    "=size - ringWidth * 3.6"
                  ],
                  "spacing": 2,
                  "rows": [
                    {
                      "if": "=helperVisible",
                      "runs": [
                        {
                          "text": "CURRENT SET",
                          "font": {
                            "family": "=helperFontFamily",
                            "size": "=helperFontSize",
                            "weight": "=helperWeight"
                          },
                          "color": "=helperColorMode == \"followGroupColor\" ? seg.groupColor : helperColor",
                          "minimumScaleFactor": 0.64
                        }
                      ]
                    },
                    {
                      "if": "=phaseVisible || repVisible",
                      "spacing": 5,
                      "runs": [
                        {
                          "if": "=phaseVisible",
                          "text": "=seg.phaseText",
                          "font": {
                            "family": "=phaseFontFamily",
                            "size": "=phaseFontSize",
                            "weight": "=phaseWeight"
                          },
                          "color": "=phaseColorMode == \"followGroupColor\" ? seg.groupColor : phaseColor",
                          "minimumScaleFactor": 0.64
                        },
                        {
                          "if": "=repVisible",
                          "text": "=seg.repText",
                          "font": {
                            "family": "=repFontFamily",
                            "size": "=repFontSize",
                            "weight": "=repWeight"
                          },
                          "color": "=repColorMode == \"followGroupColor\" ? seg.groupColor : repColor",
                          "minimumScaleFactor": 0.64
                        }
                      ]
                    },
                    {
                      "runs": [
                        {
                          "text": "=centerMetric == \"time\" ? (valueDirection == \"remaining\" ? seg.remainingText : seg.elapsedText) : (valueDirection == \"remaining\" ? seg.remainingDistanceText : seg.elapsedDistanceText)",
                          "font": {
                            "family": "=countdownFontFamily",
                            "size": "=countdownFontSize",
                            "weight": "=countdownWeight"
                          },
                          "color": "=countdownColor",
                          "minimumScaleFactor": 0.62,
                          "monospacedDigits": true,
                          "verticalPadding": 2
                        }
                      ]
                    },
                    {
                      "if": "=captionVisible",
                      "runs": [
                        {
                          "text": "=centerMetric == \"time\" ? (valueDirection == \"remaining\" ? \"remaining\" : \"elapsed\") : (valueDirection == \"remaining\" ? \"distance left\" : \"distance\")",
                          "font": {
                            "family": "=captionFontFamily",
                            "size": "=captionFontSize",
                            "weight": "=captionWeight"
                          },
                          "color": "=captionColorMode == \"followGroupColor\" ? seg.groupColor : captionColor",
                          "minimumScaleFactor": 0.64
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}