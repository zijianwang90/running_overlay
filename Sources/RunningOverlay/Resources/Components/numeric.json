                      "length": "=unitSpacing",
                      "if": "=showUnit && metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).unit != \"\" && unitPosition == \"trailing\""
                    },
                    {
                      "type": "text",
                      "text": "=metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).unit",
                      "font": {
                        "family": "=unitFont",
                        "size": "=unitSize",
                        "weight": "=unitWeight"
                      },
                      "color": "=unitFollowsZone && (metricId == \"heartRate\" || metricId == \"heartRateZone\") ? coalesce(hrZone.color, unitColor) : unitColor",
                      "if": "=showUnit && metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).unit != \"\" && unitPosition == \"trailing\""
                    }
                  ]
                },
                {
                  "type": "spacer"
                },
                {
                  "type": "spacer",
                  "length": "=labelSpacing",
                  "if": "=showLabel && (labelText != \"\" ? labelText : metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).label) != \"\" && labelPosition == \"trailing\""
                },
                {
                  "type": "text",
                  "text": "=(labelText != \"\" ? labelText : metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).label)",
                  "font": {
                    "family": "=labelFont",
                    "size": "=labelSize",
                    "weight": "=labelWeight"
                  },
                  "color": "=labelFollowsZone && (metricId == \"heartRate\" || metricId == \"heartRateZone\") ? coalesce(hrZone.color, labelColor) : labelColor",
                  "tracking": "=labelSize * 0.1",
                  "if": "=showLabel && (labelText != \"\" ? labelText : metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).label) != \"\" && labelPosition == \"trailing\""
                }
              ]
            },
            {
              "type": "spacer",
              "length": "=unitSpacing",
              "if": "=showUnit && metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).unit != \"\" && unitPosition == \"bottom\""
            },
            {
              "type": "text",
              "text": "=metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).unit",
              "font": {
                "family": "=unitFont",
                "size": "=unitSize",
                "weight": "=unitWeight"
              },
              "color": "=unitFollowsZone && (metricId == \"heartRate\" || metricId == \"heartRateZone\") ? coalesce(hrZone.color, unitColor) : unitColor",
              "if": "=showUnit && metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).unit != \"\" && unitPosition == \"bottom\"",
              "alignSelf": "=unitAlign"
            },
            {
              "type": "spacer",
              "length": "=labelSpacing",
              "if": "=showLabel && (labelText != \"\" ? labelText : metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).label) != \"\" && labelPosition == \"bottom\""
            },
