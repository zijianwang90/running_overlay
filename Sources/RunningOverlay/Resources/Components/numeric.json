    {
      "id": "paceUnit",
      "type": "enum",
      "label": {
        "en": "Unit",
        "zh-Hans": "单位"
      },
      "section": {
        "en": "Metric",
        "zh-Hans": "指标"
      },
      "options": [
        {
          "value": "paceMetric",
          "label": {
            "en": "min/km",
            "zh-Hans": "分/公里"
          }
        },
        {
          "value": "paceImperial",
          "label": {
            "en": "min/mi",
            "zh-Hans": "分/英里"
          }
        },
        {
          "value": "paceRowing",
          "label": {
            "en": "min/500m",
            "zh-Hans": "分/500米"
          }
        }
      ],
      "default": "paceMetric",
      "when": "=metricId == \"pace\" || metricId == \"avgPace\" || metricId == \"lapPace\""
    },
    {
      "id": "distanceUnit",
      "type": "enum",
      "label": {
        "en": "Unit",
        "zh-Hans": "单位"
      },
      "section": {
        "en": "Metric",
        "zh-Hans": "指标"
      },
      "options": [
        {
          "value": "distanceKilometers",
          "label": {
            "en": "km",
            "zh-Hans": "公里"
          }
        },
        {
          "value": "distanceMiles",
          "label": {
            "en": "mi",
            "zh-Hans": "英里"
          }
        },
        {
          "value": "distanceMeters",
          "label": {
            "en": "m",
            "zh-Hans": "米"
          }
        }
      ],
      "default": "distanceKilometers",
