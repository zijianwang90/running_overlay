                },
                {
                  "type": "spacer",
                  "length": "=unitSpacing",
                  "if": "=showUnit && metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).unit != \"\" && unitPosition == \"leading\""
                },
                {
                  "type": "text",
                  "text": "=metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).value",
