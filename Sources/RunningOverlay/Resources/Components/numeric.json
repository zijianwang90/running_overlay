                      },
                      "color": "=unitFollowsZone && (metricId == \"heartRate\" || metricId == \"heartRateZone\") ? coalesce(hrZone.color, unitColor) : unitColor",
                      "if": "=showUnit && metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).unit != \"\" && unitPosition == \"leading\""
                    },
                    {
                      "type": "spacer",
                      "length": "=unitSpacing",
                      "if": "=showUnit && metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).unit != \"\" && unitPosition == \"leading\""
                    },
