                  "font": {
                    "family": "=labelFont",
                    "size": "=labelSize",
                    "weight": "=labelWeight"
                  },
                  "color": "=labelFollowsZone && (metricId == \"heartRate\" || metricId == \"heartRateZone\") ? coalesce(hrZone.color, labelColor) : labelColor",
                  "tracking": "=labelSize * 0.1",
                  "if": "=showLabel && (labelText != \"\" ? labelText : metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).label) != \"\" && labelPosition == \"leading\""
                },
