              "if": "=showLabel && (labelText != \"\" ? labelText : metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).label) != \"\" && labelPosition == \"top\""
            },
