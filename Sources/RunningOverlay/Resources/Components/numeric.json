                    "family": "=unitFont",
                    "size": "=unitSize",
                    "weight": "=unitWeight"
                  },
                  "color": "=unitFollowsZone && (metricId == \"heartRate\" || metricId == \"heartRateZone\") ? coalesce(hrZone.color, unitColor) : unitColor",
                  "if": "=showUnit && metric(metricId, paceUnit, distanceUnit, elevationUnit, durationFormat, clockFormat, dateFormat, oscillationUnit, temperatureUnit).unit != \"\" && unitPosition == \"trailing\""
