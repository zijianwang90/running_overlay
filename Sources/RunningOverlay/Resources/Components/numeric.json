{
  "spec": "ros.component/0.1",
  "id": "studio.numeric",
  "version": "1.0.0",
  "name": {
    "en": "Numeric",
    "zh-Hans": "数值"
  },
  "description": {
    "en": "One activity metric with optional unit, label, icon and background, formatted by the host.",
    "zh-Hans": "显示一个运动指标，可选单位、标签、图标和背景，数值由宿主格式化。"
  },
  "author": "Running Overlay Studio",
  "license": "MIT",
  "size": "content",
  "padding": [
    "=showBackground ? paddingX : 0",
    "=showBackground ? paddingY : 0"
  ],
  "minSize": [
    "=minWidth",
    "=minHeight"
  ],
  "background": {
    "color": "=showBackground ? backgroundColor : \"#00000000\"",
    "radius": "=backgroundRadius"
  },
  "params": [
    {
      "id": "metricId",
      "type": "enum",
      "label": {
        "en": "Metric",
        "zh-Hans": "指标"
      },
      "section": {
        "en": "Metric",
        "zh-Hans": "指标"
      },
      "options": [
        {
          "value": "heartRate",
          "label": {
            "en": "Heart Rate",
            "zh-Hans": "心率"
          }
        },
        {
          "value": "heartRateZone",
          "label": {
            "en": "HR Zone",
            "zh-Hans": "心率区间"
          }
        },
        {
          "value": "pace",
          "label": {
            "en": "Pace",
            "zh-Hans": "配速"
          }
        },
        {
          "value": "avgPace",
          "label": {
            "en": "Avg Pace",
            "zh-Hans": "平均配速"
          }
        },
        {
          "value": "lapPace",
