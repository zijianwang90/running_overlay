          }
        },
        {
          "value": "date",
          "label": {
            "en": "Date",
            "zh-Hans": "日期"
          }
        },
        {
          "value": "calories",
          "label": {
            "en": "Calories",
            "zh-Hans": "卡路里"
          }
        },
        {
          "value": "elevation",
          "label": {
            "en": "Elevation",
            "zh-Hans": "海拔"
          }
        },
        {
          "value": "elevationGain",
