  "bindings": {
    "S": {
      "value": "=signal(\"host.scale\")"
    },
    "laps": {
      "list": "structure.laps"
    },
    "segment": {
      "signal": "structure.segment"
    },
    "elapsed": {
      "signal": "activity.elapsed"
    },
    "currentIndex": {
      "value": "=field(segment, \"index\")"
    },
    "timeProgress": {
      "value": "=field(segment, \"timeProgress\")"
    },
    "distanceProgress": {
      "value": "=field(segment, \"distanceProgress\")"
    },
    "stripMode": {
      "value": "=mode == \"centered\" ? \"emphasized\" : (fullLayout == \"equal\" ? \"equal\" : \"weighted\")"
    },
    "emphasis": {
      "value": "=mode == \"centered\" ? clamp(currentSegmentWidthFraction, 0.1, 0.6) : clamp(fullEqualCurrentSegmentWidthFraction, 0, 0.65)"
    },
    "windowCount": {
      "value": "=mode == \"centered\" ? visibleNeighbors : 100000"
    },
    "markerText": {
      "value": "=markerLabel == \"\" ? \"NOW\" : markerLabel"
    },
    "repText": {
      "value": "=repCounterEnabled && field(segment, \"phaseText\") == \"WORK\" ? concat(\"Rep \", field(segment, \"repText\")) : \"\""
    },
    "progressOpacity": {
      "value": "=currentProgressEnabled ? 0.30 : 0"
    },
    "markerOn": {
      "value": "=markerEnabled ? 1 : 0"
    },
    "markerLabelOn": {
      "value": "=markerLabelEnabled ? 1 : 0"
    },
    "overflowOn": {
      "value": "=overflowHintEnabled ? 1 : 0"
    },
    "innerHeight": {
      "value": "=max(segmentAreaHeight - 12, 1)"
    },
    "normalHeight": {
      "value": "=min(segmentHeight, innerHeight)"
    },
    "currentHeight": {
      "value": "=min(normalHeight * currentSegmentHeightScale, innerHeight)"
    },
    "stripHeight": {
      "value": "=6 + innerHeight / 2 + currentHeight / 2 + 4 + (6 + 2 + max(markerFontSize * 1.4, 14)) + 4"
    },
    "padX": {
      "value": "=backgroundPaddingX"
    },
    "padY": {
      "value": "=backgroundPaddingY"
    },
    "frameW": {
      "value": "=railWidth + padX * 2"
    },
    "frameH": {
      "value": "=stripHeight + padY * 2"
    }
  },
  "nodes": [
    {
      "type": "rect",
      "if": "=backgroundEnabled",
      "frame": [
        "=0",
        "=0",
        "=frameW",
        "=frameH"
      ],
      "radius": "=backgroundRadius",
      "fill": "=backgroundColor",
      "opacity": "=backgroundOpacity"
    },
    {
      "type": "timelineStrip",
      "frame": [
        "=backgroundEnabled ? padX : 0",
        "=backgroundEnabled ? padY : 0",
        "=railWidth",
        "=stripHeight"
      ],
      "segments": "=laps",
      "currentIndex": "=currentIndex",
      "elapsed": "=elapsed",
      "mode": "=stripMode",
      "emphasisFraction": "=emphasis",
      "window": "=windowCount",
      "showsWarmup": "=showsWarmup ? 1 : 0",
      "showsRest": "=showsRest ? 1 : 0",
      "showsCooldown": "=showsCooldown ? 1 : 0",
      "segmentAreaHeight": "=segmentAreaHeight",
      "segmentHeight": "=segmentHeight",
      "currentHeightScale": "=currentSegmentHeightScale",
      "minSegmentWidth": "=minSegmentWidth",
      "gap": "=segmentGap",
      "radius": "=cornerRadius",
      "currentBorderWidth": "=max(1.4, 0.5 / S)",
      "completedOpacity": "=completedOpacity",
      "futureOpacity": "=futureOpacity",
      "colors": {
        "warmup": "=warmupColor",
        "active": "=activeColor",
        "rest": "=restColor",
        "cooldown": "=cooldownColor",
        "unknown": "=unknownColor"
      },
      "labels": {
        "font": {
          "family": "=fontFamily",
          "size": 16,
          "weight": "regular"
        },
        "currentWorkDistance": "=currentWorkDistance",
        "currentWorkTime": "=currentWorkTime",
        "currentRestKind": "=currentRestKindEnabled ? 1 : 0",
        "currentRestDistance": "=currentRestDistance",
        "currentRestTime": "=currentRestTime",
        "neighbor": "=neighborLabel"
      },
      "progress": {
        "value": "=timeProgress",
        "color": "#FFFFFF",
        "opacity": "=progressOpacity"
      },
      "marker": {
        "enabled": "=markerOn",
        "position": "=markerPosition == \"segmentCenter\" ? \"center\" : \"progress\"",
        "color": "=markerColor",
        "label": "=markerText",
        "showsLabel": "=markerLabelOn",
        "font": {
          "family": "=markerFontFamily == \"\" ? fontFamily : markerFontFamily",
          "size": "=markerFontSize",
          "weight": "=markerFontWeight"
        }
      },
      "overflow": {
        "enabled": "=overflowOn",
        "text": "···",
        "color": "=foregroundColor",
        "inset": 36
      },
      "repText": "=repText",
      "distanceProgress": "=distanceProgress"
    },
    {
      "type": "rect",
      "if": "=borderEnabled",
      "frame": [
        "=0",
        "=0",
        "=frameW",
        "=frameH"
      ],
      "radius": "=backgroundRadius",
      "fill": "#00000000",
      "stroke": "=borderColor",
      "strokeWidth": "=max(borderWidth, 0.5 / S)",
      "opacity": "=borderOpacity"
    }
  ]
}
