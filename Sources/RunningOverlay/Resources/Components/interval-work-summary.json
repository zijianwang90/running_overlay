                {
                  "alignment": "firstTextBaseline",
                  "spacing": "=7 / signal(\"host.scale\")",
                  "runs": [
                    {
                      "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), primaryMetric).value : field(field(work.metrics, \"metric\"), primaryMetric).value",
                      "font": {
                        "family": "=primaryValueFontFamily",
                        "size": "=primaryValueFontSize",
                        "weight": "=primaryValueFontWeight"
                      },
                      "color": "=primaryValueColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : primaryValueCustomColor",
                      "minimumScaleFactor": 0.55,
                      "monospacedDigits": true
                    },
                    {
                      "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), primaryMetric).unit : field(field(work.metrics, \"metric\"), primaryMetric).unit",
                      "if": "=(unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), primaryMetric).unit : field(field(work.metrics, \"metric\"), primaryMetric).unit) != \"\"",
                      "font": {
                        "family": "=primaryValueFontFamily",
                        "size": "=primaryValueFontSize * 0.34",
                        "weight": "=primaryValueFontWeight"
                      },
                      "color": "=primaryValueColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : primaryValueCustomColor",
                      "minimumScaleFactor": 1,
                      "opacity": 0.9
                    }
                  ]
                }
              ]
            },
            {
              "type": "spacer",
              "length": "=5 / signal(\"host.scale\")",
              "if": "=primaryMetricLabelVisible && primaryLabelTextVisible"
            },
            {
              "type": "text",
              "if": "=primaryMetricLabelVisible && primaryLabelTextVisible",
              "text": "=(unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), primaryMetric).label : field(field(work.metrics, \"metric\"), primaryMetric).label)",
              "font": {
                "family": "=primaryLabelFontFamily",
                "size": "=primaryLabelFontSize",
                "weight": "=primaryLabelFontWeight"
              },
              "color": "=primaryLabelColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : primaryLabelCustomColor",
              "align": "center",
              "maxWidth": "=(summaryWidth - 2 * backgroundPaddingX)"
            },
            {
              "type": "spacer",
              "min": "=slot1Visible || slot2Visible || slot3Visible ? 12 / signal(\"host.scale\") : 0"
            },
            {
              "type": "columns",
              "if": "=slot1Visible || slot2Visible || slot3Visible",
              "width": "=(summaryWidth - 2 * backgroundPaddingX)",
              "divider": {
                "width": "=dividerEnabled ? max(dividerWidth, 0.5) / signal(\"host.scale\") : 0",
                "color": "#FFFFFF",
                "opacity": "=dividerOpacity",
                "height": "=dividerEnabled ? summaryHeight * 0.26 : 0"
              },
              "children": [
                {
                  "type": "textRows",
                  "maxWidth": "=((summaryWidth - 2 * backgroundPaddingX) / 3 - 16 / signal(\"host.scale\"))",
                  "spacing": "=4 / signal(\"host.scale\")",
                  "rows": [
                    {
                      "alignment": "firstTextBaseline",
                      "spacing": "=4 / signal(\"host.scale\")",
                      "runs": [
                        {
                          "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot1Metric).value : field(field(work.metrics, \"metric\"), slot1Metric).value",
                          "font": {
                            "family": "=secondaryValueFontFamily",
                            "size": "=secondaryValueFontSize",
                            "weight": "=secondaryValueFontWeight"
                          },
                          "color": "=secondaryValueColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : secondaryValueCustomColor",
                          "minimumScaleFactor": 0.55,
                          "monospacedDigits": true
                        },
                        {
                          "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot1Metric).unit : field(field(work.metrics, \"metric\"), slot1Metric).unit",
                          "if": "=(unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot1Metric).unit : field(field(work.metrics, \"metric\"), slot1Metric).unit) != \"\"",
                          "font": {
                            "family": "=secondaryValueFontFamily",
                            "size": "=secondaryValueFontSize * 0.38",
                            "weight": "=secondaryValueFontWeight"
                          },
                          "color": "=secondaryValueColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : secondaryValueCustomColor",
                          "minimumScaleFactor": 1,
                          "opacity": 0.9
                        }
                      ]
                    },
                    {
                      "alignment": "center",
                      "spacing": 0,
                      "if": "=secondaryLabelTextVisible && slot1LabelVisible",
                      "runs": [
                        {
                          "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot1Metric).label : field(field(work.metrics, \"metric\"), slot1Metric).label",
                          "font": {
                            "family": "=secondaryLabelFontFamily",
                            "size": "=secondaryLabelFontSize",
                            "weight": "=secondaryLabelFontWeight"
                          },
                          "color": "=secondaryLabelColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : secondaryLabelCustomColor",
                          "minimumScaleFactor": 1
                        }
                      ]
                    }
                  ],
                  "if": "=slot1Visible"
                },
                {
                  "type": "textRows",
                  "maxWidth": "=((summaryWidth - 2 * backgroundPaddingX) / 3 - 16 / signal(\"host.scale\"))",
                  "spacing": "=4 / signal(\"host.scale\")",
                  "rows": [
                    {
                      "alignment": "firstTextBaseline",
                      "spacing": "=4 / signal(\"host.scale\")",
                      "runs": [
                        {
                          "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot2Metric).value : field(field(work.metrics, \"metric\"), slot2Metric).value",
                          "font": {
                            "family": "=secondaryValueFontFamily",
                            "size": "=secondaryValueFontSize",
                            "weight": "=secondaryValueFontWeight"
                          },
                          "color": "=secondaryValueColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : secondaryValueCustomColor",
                          "minimumScaleFactor": 0.55,
