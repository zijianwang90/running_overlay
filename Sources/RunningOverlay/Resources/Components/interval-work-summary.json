                            "weight": "=secondaryLabelFontWeight"
                          },
                          "color": "=secondaryLabelColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : secondaryLabelCustomColor",
                          "minimumScaleFactor": 1
                        }
                      ]
                    }
                  ],
                  "if": "=slot3Visible"
                }
              ]
            },
            {
              "type": "spacer",
              "if": "=slot1Visible || slot2Visible || slot3Visible"
            }
          ],
          "if": "=coalesce(work.completionAge, 1000000) <= displayDuration"
        }
      ]
    }
  ]
}