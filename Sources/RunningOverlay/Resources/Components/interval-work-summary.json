                        },
                        {
                          "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot2Metric).unit : field(field(work.metrics, \"metric\"), slot2Metric).unit",
                          "if": "=(unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot2Metric).unit : field(field(work.metrics, \"metric\"), slot2Metric).unit) != \"\"",
                          "font": {
                            "family": "=secondaryValueFontFamily",
                            "size": "=secondaryValueFontSize * 0.38",
                            "weight": "=secondaryValueFontWeight"
                          },
                          "color": "=secondaryValueColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : secondaryValueCustomColor",
                          "minimumScaleFactor": 1,
                          "opacity": 0.9
                        }
                      ]
                    },
                    {
                      "alignment": "center",
                      "spacing": 0,
                      "if": "=secondaryLabelTextVisible && slot2LabelVisible",
                      "runs": [
                        {
                          "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot2Metric).label : field(field(work.metrics, \"metric\"), slot2Metric).label",
                          "font": {
                            "family": "=secondaryLabelFontFamily",
                            "size": "=secondaryLabelFontSize",
                            "weight": "=secondaryLabelFontWeight"
                          },
                          "color": "=secondaryLabelColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : secondaryLabelCustomColor",
                          "minimumScaleFactor": 1
                        }
                      ]
                    }
                  ],
                  "if": "=slot2Visible"
                },
                {
                  "type": "textRows",
                  "maxWidth": "=((summaryWidth - 2 * backgroundPaddingX) / 3 - 16 / signal(\"host.scale\"))",
                  "spacing": "=4 / signal(\"host.scale\")",
                  "rows": [
                    {
                      "alignment": "firstTextBaseline",
                      "spacing": "=4 / signal(\"host.scale\")",
                      "runs": [
                        {
                          "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot3Metric).value : field(field(work.metrics, \"metric\"), slot3Metric).value",
                          "font": {
                            "family": "=secondaryValueFontFamily",
                            "size": "=secondaryValueFontSize",
                            "weight": "=secondaryValueFontWeight"
                          },
                          "color": "=secondaryValueColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : secondaryValueCustomColor",
                          "minimumScaleFactor": 0.55,
                          "monospacedDigits": true
                        },
                        {
                          "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot3Metric).unit : field(field(work.metrics, \"metric\"), slot3Metric).unit",
                          "if": "=(unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot3Metric).unit : field(field(work.metrics, \"metric\"), slot3Metric).unit) != \"\"",
                          "font": {
                            "family": "=secondaryValueFontFamily",
                            "size": "=secondaryValueFontSize * 0.38",
                            "weight": "=secondaryValueFontWeight"
                          },
                          "color": "=secondaryValueColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : secondaryValueCustomColor",
                          "minimumScaleFactor": 1,
                          "opacity": 0.9
                        }
                      ]
                    },
                    {
                      "alignment": "center",
                      "spacing": 0,
                      "if": "=secondaryLabelTextVisible && slot3LabelVisible",
                      "runs": [
                        {
                          "text": "=unitSystem == \"imperial\" ? field(field(work.metrics, \"imperial\"), slot3Metric).label : field(field(work.metrics, \"metric\"), slot3Metric).label",
                          "font": {
