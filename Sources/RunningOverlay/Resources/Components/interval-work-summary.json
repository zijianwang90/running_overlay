                "=summaryHeight"
              ],
              "radius": "=backgroundRadius",
              "fill": "=backgroundColor",
              "opacity": "=backgroundOpacity"
            }
          ]
        },
        {
          "type": "rect",
          "if": "=borderEnabled",
          "frame": [
            0,
            0,
            "=summaryWidth",
            "=summaryHeight"
          ],
          "radius": "=backgroundRadius",
          "fill": "#00000000",
          "stroke": "#FFFFFF",
          "strokeWidth": "=max(borderWidth, 0.5)",
          "opacity": "=borderOpacity"
        }
      ]
    },
    {
      "type": "group",
      "frame": [
        0,
        0,
        "=summaryWidth",
        "=summaryHeight"
      ],
      "children": [
        {
          "type": "stack",
          "frame": [
            "=backgroundPaddingX",
            "=backgroundPaddingY",
            "=(summaryWidth - 2 * backgroundPaddingX)",
            "=summaryHeight - 2 * backgroundPaddingY"
          ],
          "direction": "vertical",
          "spacing": 0,
          "crossAlign": "center",
          "children": [
            {
              "type": "text",
              "if": "=componentLabelTextVisible",
              "text": "=upper(componentLabel)",
              "font": {
                "family": "=componentLabelFontFamily",
                "size": "=componentLabelFontSize",
                "weight": "=componentLabelFontWeight"
              },
              "color": "=componentLabelColorMode == \"followGroupColor\" ? (accentColorMode == \"followGroupColor\" ? work.groupColor : accentColor) : componentLabelCustomColor",
              "align": "center",
              "maxWidth": "=(summaryWidth - 2 * backgroundPaddingX)"
            },
            {
              "type": "spacer",
              "length": "=8 / signal(\"host.scale\")",
