  "bindings": {
    "paceUnit": {
      "value": "=unitSystem == \"imperial\" ? \"paceImperial\" : \"paceMetric\""
    },
    "distanceUnit": {
      "value": "=unitSystem == \"imperial\" ? \"distanceMiles\" : \"distanceKilometers\""
    },
    "elevationUnit": {
      "value": "=unitSystem == \"imperial\" ? \"elevationFeet\" : \"elevationMeters\""
    },
    "temperatureUnit": {
      "value": "=unitSystem == \"imperial\" ? \"temperatureFahrenheit\" : \"temperatureCelsius\""
    },
    "visibleCount": {
      "value": "=(slot1Metric != \"none\" ? 1 : 0) + (slot2Metric != \"none\" ? 1 : 0) + (slot3Metric != \"none\" ? 1 : 0) + (slot4Metric != \"none\" ? 1 : 0)"
    },
    "dividerW": {
      "value": "=dividerEnabled && visibleCount > 1 ? dividerThickness : 0"
    },
    "innerWidth": {
      "value": "=barWidth - 2 * paddingX"
    },
    "cellWidth": {
      "value": "=max((innerWidth - dividerW * max(visibleCount - 1, 0)) / max(visibleCount, 1), 1)"
    }
  },
  "nodes": [
    {
      "type": "rect",
      "frame": [
        0,
        0,
        "=barWidth",
        "=barHeight"
      ],
      "radius": "=backgroundRadius",
      "fill": "=backgroundColor",
      "opacity": "=backgroundEnabled ? backgroundOpacity : 0"
    },
    {
      "type": "stack",
      "frame": [
        "=paddingX",
        0,
        "=innerWidth",
        "=barHeight"
      ],
      "direction": "vertical",
      "crossAlign": "center",
      "spacing": 0,
      "children": [
        {
          "type": "spacer"
        },
        {
          "type": "columns",
          "width": "=innerWidth",
          "divider": {
            "width": "=dividerW",
            "color": "=labelColor",
            "opacity": "=dividerOpacity",
            "height": "=dividerHeight"
          },
          "children": [
            {
              "type": "textRows",
              "if": "=slot1Metric != \"none\"",
              "maxWidth": "=cellWidth",
              "spacing": "=valueLabelSpacing",
              "rows": [
                {
                  "alignment": "firstTextBaseline",
                  "spacing": 3,
                  "runs": [
                    {
                      "text": "=field(metric(slot1Metric, paceUnit, distanceUnit, elevationUnit, temperatureUnit), \"value\")",
                      "font": {
                        "family": "=valueFontFamily",
                        "size": "=valueFontSize",
                        "weight": "=valueFontWeight"
                      },
                      "color": "=valueColor",
                      "minimumScaleFactor": 0.45,
                      "monospacedDigits": true
                    },
                    {
                      "text": "=field(metric(slot1Metric, paceUnit, distanceUnit, elevationUnit, temperatureUnit), \"unit\")",
                      "if": "=field(metric(slot1Metric, paceUnit, distanceUnit, elevationUnit, temperatureUnit), \"unit\") != \"\"",
                      "font": {
                        "family": "=valueFontFamily",
                        "size": "=valueFontSize * unitScale",
                        "weight": "=valueFontWeight"
                      },
                      "color": "=valueColor",
                      "opacity": 0.76,
                      "minimumScaleFactor": 0.7
                    }
                  ]
                },
                {
                  "runs": [
                    {
                      "text": "=slot1Label != \"\" ? upper(slot1Label) : upper(field(metric(slot1Metric, paceUnit, distanceUnit, elevationUnit, temperatureUnit), \"shortLabel\"))",
                      "font": {
                        "family": "=labelFontFamily",
                        "size": "=labelFontSize",
                        "weight": "=labelFontWeight"
                      },
                      "color": "=labelColor",
                      "opacity": "=labelOpacity",
                      "minimumScaleFactor": 0.7
                    }
